# AlgoKnife Crypto Integration Configuration
# Rename to .env and fill in your credentials

# Exchange: binance, coinbase, kraken, etc.
CRYPTO_EXCHANGE=

# API Credentials
CRYPTO_API_KEY=
CRYPTO_API_SECRET=

# Optional: API Passphrase (required for some exchanges like Coinbase)
CRYPTO_API_PASSPHRASE=

# Trading Mode: paper or live
CRYPTO_TRADING_MODE=paper

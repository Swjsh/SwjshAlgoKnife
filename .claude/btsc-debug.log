[2026-03-22T11:54:05Z] PRE-TOOL-USE: INPUT: {"session_id":"76e04d75-d5f6-450f-8a85-ef4870bcbcb1","transcript_path":"C:\\Users\\jackw\\.claude\\projects\\C--Users-jackw-Desktop-SwjshAlgoKnife\\76e04d75-d5f6-450f-8a85-ef4870bcbcb1.jsonl","cwd":"C:\\Users\\jackw\\Desktop\\SwjshAlgoKnife","permission_mode":"default","hook_event_name":"PreToolUse","tool_name":"Edit","tool_input":{"file_path":"C:\\Users\\jackw\\Desktop\\SwjshAlgoKnife\\scripts\\agent_runner.ts","old_string":"// startORB() — called from the delayed launch block below\n\n// ═══════════════════════════════════════════════════════════════════════════\n// DELAYED AGENT LAUNCH — wait for Next.js dashboard to be ready","new_string":"// startORB() — called from the delayed launch block below\n\n// ═══════════════════════════════════════════════════════════════════════════\n// PROCESS METRICS COLLECTION — Monitor RSS, CPU% for all child processes\n// ═══════════════════════════════════════════════════════════════════════════\n\n// Map agent DB keys to their process variables\nfunction getAgentProcessMap(): Record<string, ChildProcess | null> {\n    return {\n        fx: sterlingProcess,\n        crypto: bitcoinBobProcess,\n        futures: pivotPeteProcess,\n        boba: bobaProcess,\n        spx: spxProcess,\n        orb: orbProcess\n    };\n}\n\n// Collect metrics for a single process\nasync function getProcessMetrics(proc: ChildProcess | null): Promise<ProcessMetrics | null> {\n    if (!proc || !proc.pid || proc.killed) {\n        return null;\n    }\n\n    try {\n        const stats = await pidusage(proc.pid);\n        return {\n            pid: proc.pid,\n            cpu: Math.round(stats.cpu * 100) / 100,  // Round to 2 decimal places\n            memory: stats.memory,\n            memoryMB: Math.round(stats.memory / 1024 / 1024 * 10) / 10,  // Round to 1 decimal\n            timestamp: new Date().toISOString()\n        };\n    } catch (err) {\n        // Process may have exited between check and pidusage call\n        return null;\n    }\n}\n\n// Collect metrics for all agent processes and update DB\nasync function collectAllProcessMetrics(): Promise<void> {\n    const processMap = getAgentProcessMap();\n    const agentKeys = Object.keys(processMap) as (keyof DbSchema)[];\n\n    for (const agentKey of agentKeys) {\n        const proc = processMap[agentKey];\n        const metrics = await getProcessMetrics(proc);\n\n        if (metrics && db[agentKey]) {\n            db[agentKey].processMetrics = metrics;\n\n            // Check memory thresholds and log alerts\n            if (metrics.memoryMB > MEMORY_THRESHOLDS.MAXIMUM) {\n                console.log(`🚨 [MEMORY CRITICAL] ${db[agentKey].meta.name} using ${metrics.memoryMB}MB (>${MEMORY_THRESHOLDS.MAXIMUM}MB) - Consider restart!`);\n            } else if (metrics.memoryMB > MEMORY_THRESHOLDS.CRITICAL) {\n                console.log(`⚠️ [MEMORY HIGH] ${db[agentKey].meta.name} using ${metrics.memoryMB}MB (>${MEMORY_THRESHOLDS.CRITICAL}MB)`);\n            } else if (metrics.memoryMB > MEMORY_THRESHOLDS.WARNING) {\n                console.log(`📊 [MEMORY WARNING] ${db[agentKey].meta.name} using ${metrics.memoryMB}MB (>${MEMORY_THRESHOLDS.WARNING}MB)`);\n            }\n        }\n    }\n\n    saveDb();\n}\n\n// ═══════════════════════════════════════════════════════════════════════════\n// DELAYED AGENT LAUNCH — wait for Next.js dashboard to be ready","replace_all":false},"tool_use_id":"toolu_01V21SwGmZcUb6RgyXUZTdtD"}

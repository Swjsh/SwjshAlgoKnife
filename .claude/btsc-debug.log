[2026-03-22T11:54:29Z] PRE-TOOL-USE: INPUT: {"session_id":"76e04d75-d5f6-450f-8a85-ef4870bcbcb1","transcript_path":"C:\\Users\\jackw\\.claude\\projects\\C--Users-jackw-Desktop-SwjshAlgoKnife\\76e04d75-d5f6-450f-8a85-ef4870bcbcb1.jsonl","cwd":"C:\\Users\\jackw\\Desktop\\SwjshAlgoKnife","permission_mode":"default","hook_event_name":"PreToolUse","tool_name":"Edit","tool_input":{"file_path":"C:\\Users\\jackw\\Desktop\\SwjshAlgoKnife\\scripts\\agent_runner.ts","old_string":"// --- HEALTH WATCHDOG ---\n// Monitors agent freshness and market connectivity\nfunction runHealthWatchdog() {\n    const now = Date.now();\n    const allAgents: (keyof DbSchema)[] = ['fx', 'crypto', 'futures', 'boba', 'spx', 'orb'];\n    let staleCount = 0;\n\n    // Check each agent's last update timestamp\n    allAgents.forEach(agentKey => {\n        const agent = db[agentKey];\n        if (!agent) return;\n\n        const lastUpdate = new Date(agent.last_updated).getTime();\n        const timeSinceUpdate = (now - lastUpdate) / 1000 / 60; // minutes\n\n        if (timeSinceUpdate > 10) {\n            staleCount++;\n            console.log(`⚠️ [WATCHDOG] Agent ${agent.meta.name} is STALE (last update: ${timeSinceUpdate.toFixed(1)}m ago)`);\n            agent.status = 'STALE';\n            saveDb();\n        }\n    });\n\n    // Check market WebSocket connectivity via lastTickTime\n    const timeSinceLastTick = (now - lastTickTime) / 1000 / 60; // minutes\n    if (timeSinceLastTick > 5) {\n        console.log(`⚠️ [WATCHDOG] Market WebSocket appears disconnected (no ticks for ${timeSinceLastTick.toFixed(1)}m)`);\n    }\n\n    // Log summary\n    const activeCount = allAgents.filter(k => db[k].status === 'ACTIVE').length;\n    console.log(`📊 [WATCHDOG] System Health: ${activeCount}/${allAgents.length} agents active | Market tick age: ${timeSinceLastTick.toFixed(1)}m | Stale agents: ${staleCount}`);\n}\n\nsetInterval(runHealthWatchdog, 60000);\nconsole.log('⏥ [WATCHDOG] Health Watchdog Started (60s interval)');","new_string":"// --- HEALTH WATCHDOG ---\n// Monitors agent freshness, market connectivity, AND process-level metrics\nasync function runHealthWatchdog() {\n    const now = Date.now();\n    const allAgents: (keyof DbSchema)[] = ['fx', 'crypto', 'futures', 'boba', 'spx', 'orb'];\n    let staleCount = 0;\n\n    // 1. Collect process metrics for all agents (PULSE-12)\n    await collectAllProcessMetrics();\n\n    // 2. Check each agent's last update timestamp\n    allAgents.forEach(agentKey => {\n        const agent = db[agentKey];\n        if (!agent) return;\n\n        const lastUpdate = new Date(agent.last_updated).getTime();\n        const timeSinceUpdate = (now - lastUpdate) / 1000 / 60; // minutes\n\n        if (timeSinceUpdate > 10) {\n            staleCount++;\n            console.log(`⚠️ [WATCHDOG] Agent ${agent.meta.name} is STALE (last update: ${timeSinceUpdate.toFixed(1)}m ago)`);\n            agent.status = 'STALE';\n            saveDb();\n        }\n    });\n\n    // 3. Check market WebSocket connectivity via lastTickTime\n    const timeSinceLastTick = (now - lastTickTime) / 1000 / 60; // minutes\n    if (timeSinceLastTick > 5) {\n        console.log(`⚠️ [WATCHDOG] Market WebSocket appears disconnected (no ticks for ${timeSinceLastTick.toFixed(1)}m)`);\n    }\n\n    // 4. Calculate total memory usage across all agents\n    let totalMemoryMB = 0;\n    let totalCPU = 0;\n    let processCount = 0;\n    allAgents.forEach(agentKey => {\n        const metrics = db[agentKey]?.processMetrics;\n        if (metrics) {\n            totalMemoryMB += metrics.memoryMB;\n            totalCPU += metrics.cpu;\n            processCount++;\n        }\n    });\n\n    // 5. Log summary with process metrics\n    const activeCount = allAgents.filter(k => db[k].status === 'ACTIVE').length;\n    console.log(`📊 [WATCHDOG] System Health: ${activeCount}/${allAgents.length} agents active | Market tick age: ${timeSinceLastTick.toFixed(1)}m | Stale agents: ${staleCount}`);\n    if (processCount > 0) {\n        console.log(`💾 [WATCHDOG] Process Metrics: ${processCount} processes | Total RSS: ${totalMemoryMB.toFixed(1)}MB | Total CPU: ${totalCPU.toFixed(1)}%`);\n    }\n}\n\nsetInterval(runHealthWatchdog, 60000);\nconsole.log('⏥ [WATCHDOG] Health Watchdog Started (60s interval) — with process metrics (PULSE-12)');","replace_all":false},"tool_use_id":"toolu_01BsW9wWjsuRkxSk1S9Vdxii"}

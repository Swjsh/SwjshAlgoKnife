putWrapper {\n+    flex: 1;\n+    display: flex;\n+    align-items: center;\n+    gap: 8px;\n+}\n+\n+.broadcastLabel {\n+    font-size: 10px;\n+    font-weight: 600;\n+    letter-spacing: 0.08em;\n+    text-transform: uppercase;\n+    color: #a855f7;\n+    white-space: nowrap;\n+    flex-shrink: 0;\n+}\n+\n+.broadcastInput {\n+    background: rgba(9, 9, 11, 0.6);\n+    border: 1px solid rgba(255, 255, 255, 0.1);\n+    border-radius: 5px;\n+    padding: 5px 10px;\n+    font-family: 'JetBrains Mono', monospace;\n+    font-size: 12px;\n+    color: rgba(255, 255, 255, 0.9);\n+    outline: none;\n+    flex: 1;\n+    transition: border-color 0.2s ease, box-shadow 0.2s ease;\n+}\n+\n+.broadcastInput::placeholder {\n+    color: rgba(255, 255, 255, 0.3);\n+}\n+\n+.broadcastInput:focus {\n+    border-color: #a855f7;\n+    box-shadow: 0 0 0 2px rgba(168, 85, 247, 0.15);\n+}\n+\n+.broadcastButton {\n+    display: flex;\n+    align-items: center;\n+    gap: 6px;\n+    padding: 7px 14px;\n+    background: linear-gradient(135deg, #a855f7, #7c3aed);\n+    border: none;\n+    border-radius: 6px;\n+    font-family: inherit;\n+    font-size: 11px;\n+    font-weight: 600;\n+    color: white;\n+    cursor: pointer;\n+    transition: all 0.2s ease;\n+    flex-shrink: 0;\n+}\n+\n+.broadcastButton:hover {\n+    transform: scale(1.02);\n+    box-shadow: 0 4px 16px rgba(168, 85, 247, 0.35);\n+}\n+\n+.broadcastButton:disabled {\n+    opacity: 0.5;\n+    cursor: not-allowed;\n+    transform: none;\n+    box-shadow: none;\n+}\n+\n+/* Jira Ticket Strip - Bottom Row */\n+.ticketStripWrapper {\n+    flex-shrink: 0;\n+    margin-top: 2px;\n+}\n+\n+/* Agent Grid - 2x3 layout, full width */\n+.agentGrid {\n+    display: grid;\n+    grid-template-columns: repeat(3, 1fr);\n+    grid-template-rows: repeat(2, 1fr);\n+    gap: 6px;\n+    flex: 1.2;\n+    min-height: 0;\n+    overflow: hidden;\n+}\n+\n+/* Loading State */\n+.loading {\n+    display: flex;\n+    flex-direction: column;\n+    align-items: center;\n+    justify-content: center;\n+    min-height: 100vh;\n+    background: var(--bg-main, hsl(222, 47%, 11%));\n+    gap: 16px;\n+    color: rgba(255, 255, 255, 0.5);\n+}\n+\n+.spinner {\n+    width: 40px;\n+    height: 40px;\n+    border: 3px solid rgba(6, 182, 212, 0.2);\n+    border-top-color: #06b6d4;\n+    border-radius: 50%;\n+    animation: spin 0.8s linear infinite;\n+}\n+\n+.loadingText {\n+    font-size: 12px;\n+    font-family: 'JetBrains Mono', monospace;\n+    letter-spacing: 0.2em;\n+    text-transform: uppercase;\n+}\n+\n+/* Responsive Design */\n+@media (max-width: 1400px) {\n+    .agentGrid {\n+        grid-template-columns: repeat(2, 1fr);\n+        grid-template-rows: repeat(3, 1fr);\n+    }\n+}\n+\n+@media (max-width: 768px) {\n+    .container {\n+        padding: 10px;\n+    }\n+\n+    .topBar {\n+        flex-wrap: wrap;\n+        gap: 6px;\n+    }\n+\n+    .agentGrid {\n+        grid-template-columns: repeat(2, 1fr);\n+        grid-template-rows: repeat(3, 1fr);\n+    }\n+}\n+\n+/* Animations */\n+@keyframes spin {\n+    to {\n+        transform: rotate(360deg);\n+    }\n+}\n+\n+/* Glassmorphism enhancement for panels */\n+.glassPanel {\n+    background: rgba(17, 17, 22, 0.8);\n+    backdrop-filter: blur(12px);\n+    border: 1px solid rgba(255, 255, 255, 0.08);\n+    border-radius: 14px;\n+}\n+\n+/* Theme Overrides */\n+:global([data-theme='light']) .container {\n+    background: var(--bg-main);\n+    color: var(--text-primary);\n+}\n+\n+:global([data-theme='light']) .title {\n+    background: linear-gradient(135deg, #0891b2, #7c3aed);\n+    -webkit-background-clip: text;\n+    -webkit-text-fill-color: transparent;\n+    background-clip: text;\n+}\n+\n+:global([data-theme='light']) .subtitle {\n+    color: rgba(0, 0, 0, 0.5);\n+}\n+\n+:global([data-theme='light']) .clockSection {\n+    background: rgba(6, 182, 212, 0.06);\n+    border-color: rgba(6, 182, 212, 0.15);\n+}\n+\n+:global([data-theme='light']) .clockTime {\n+    color: #0891b2;\n+}\n+\n+:global([data-theme='light']) .clockDate {\n+    color: rgba(0, 0, 0, 0.5);\n+}\n+\n+:global([data-theme='light']) .loading {\n+    background: var(--bg-main);\n+    color: rgba(0, 0, 0, 0.5);\n+}\n+\n+:global([data-theme='light']) .spinner {\n+    border-color: rgba(8, 145, 178, 0.2);\n+    border-top-color: #0891b2;\n+}\ndiff --git a/src/app/activity-feed/page.tsx b/src/app/activity-feed/page.tsx\nnew file mode 100644\nindex 0000000..c71e585\n--- /dev/null\n+++ b/src/app/activity-feed/page.tsx\n@@ -0,0 +1,270 @@\n+'use client';\n+\n+import React, { useState, useEffect, useCallback, useMemo, useRef, KeyboardEvent } from 'react';\n+import { Activity, Radio, Send, RefreshCw } from 'lucide-react';\n+import { useActivityFeed } from '@/hooks/useActivityFeed';\n+import { useKeyboardShortcuts } from '@/hooks/useKeyboardShortcuts';\n+import { useJiraTickets } from '@/hooks/useJiraTickets';\n+import { useJiraLoop } from '@/hooks/useJiraLoop';\n+import { ActivityStats } from '@/components/ActivityFeed/ActivityStats';\n+import { AgentTerminal } from '@/components/ActivityFeed/AgentTerminal';\n+import { PermissionQueue } from '@/components/ActivityFeed/PermissionQueue';\n+import { TicketStrip } from '@/components/ActivityFeed/TicketStrip';\n+import styles from './page.module.css';\n+\n+// Agent order for the grid (7 agents: 2x3 + 1)\n+const AGENT_ORDER = ['chief', 'hunter', 'ops', 'scout', 'arbiter', 'cortana'] as const;\n+\n+export default function ActivityFeedPage() {\n+    const [currentTime, setCurrentTime] = useState(new Date());\n+    const [isHydrated, setIsHydrated] = useState(false);\n+    const [broadcastValue, setBroadcastValue] = useState('');\n+    const [isRefreshing, setIsRefreshing] = useState(false);\n+    const broadcastInputRef = useRef<HTMLInputElement>(null);\n+\n+    // Connect to WebSocket for real-time updates\n+    const {\n+        agents,\n+        permissions,\n+        isConnected,\n+        actionsToday,\n+        lastActivity,\n+        onlineCount,\n+        busyCount,\n+        activeCount,\n+        totalAgents,\n+        totalApproved,\n+        totalRejected,\n+        permissionStatsByAgent,\n+        toolExecutions,\n+        toolSuccesses,\n+        toolFailures,\n+        heartbeat,\n+        nudgeAgent,\n+        nudgeAllStale,\n+        approve,\n+        reject,\n+        approveAll,\n+        sendCommand,\n+        broadcastCommand,\n+    } = useActivityFeed();\n+\n+    // Fetch Jira tickets for all agents\n+    const { tickets, isLoading: ticketsLoading, refetch: refetchTickets, lastUpdated } = useJiraTickets();\n+\n+    // Jira loop controls\n+    const { loopState, isLoading: loopLoading, startLoop, stopLoop } = useJiraLoop();\n+\n+    // Master refresh — Jira tickets + agent status re-poll\n+    const handleMasterRefresh = useCallback(async () => {\n+        setIsRefreshing(true);\n+        try {\n+            await Promise.all([\n+                refetchTickets(),\n+                fetch('/api/activity/agents').catch(() => {}),\n+            ]);\n+        } finally {\n+            setTimeout(() => setIsRefreshing(false), 600);\n+        }\n+    }, [refetchTickets]);\n+\n+    // Handle ticket status transitions\n+    const handleTicketTransition = useCallback(async (key: string, status: 'In Progress' | 'Done', comment?: string) => {\n+        try {\n+            const response = await fetch(`/api/jira/tickets/${key}/transition`, {\n+                method: 'POST',\n+                headers: { 'Content-Type': 'application/json' },\n+                body: JSON.stringify({ status, comment })\n+            });\n+            if (!response.ok) throw new Error('Transition failed');\n+            // Refresh tickets after successful transition\n+            refetchTickets();\n+        } catch (error) {\n+            console.error('[ActivityFeed] Transition failed:', error);\n+        }\n+    }, [refetchTickets]);\n+\n+    // Keyboard shortcut handlers\n+    const handleApproveFirst = useCallback(() => {\n+        if (permissions.length > 0) {\n+            approve(permissions[0].id);\n+        }\n+    }, [permissions, approve]);\n+\n+    const handleRejectFirst = useCallback(() => {\n+        if (permissions.length > 0) {\n+            reject(permissions[0].id);\n+        }\n+    }, [permissions, reject]);\n+\n+    const handleClearSelection = useCallback(() => {\n+        // Could be used to clear any UI selection state\n+        console.log('[ActivityFeed] Selection cleared');\n+    }, []);\n+\n+    // Handle broadcast command submission\n+    const handleBroadcast = useCallback(() => {\n+        const command = broadcastValue.trim();\n+        if (!command) return;\n+\n+        broadcastCommand(command);\n+        setBroadcastValue('');\n+        console.log(`[ActivityFeed] Broadcast to all: ${command}`);\n+    }, [broadcastValue, broadcastCommand]);\n+\n+    // Handle broadcast keyboard shortcut\n+    const handleBroadcastKeyDown = useCallback((e: KeyboardEvent<HTMLInputElement>) => {\n+        if (e.key === 'Enter' && !e.shiftKey) {\n+            e.preventDefault();\n+            handleBroadcast();\n+        }\n+    }, [handleBroadcast]);\n+\n+    // Register keyboard shortcuts\n+    useKeyboardShortcuts({\n+        onApproveFirst: handleApproveFirst,\n+        onRejectFirst: handleRejectFirst,\n+        onApproveAll: approveAll,\n+        onClearSelection: handleClearSelection,\n+        enabled: true,\n+    });\n+\n+    // Update clock every second\n+    useEffect(() => {\n+        setIsHydrated(true);\n+        const interval = setInterval(() => {\n+            setCurrentTime(new Date());\n+        }, 1000);\n+        return () => clearInterval(interval);\n+    }, []);\n+\n+    // Format time for display\n+    const formattedTime = useMemo(() => {\n+        return currentTime.toLocaleTimeString('en-US', {\n+            hour12: false,\n+            hour: '2-digit',\n+            minute: '2-digit',\n+            second: '2-digit',\n+        });\n+    }, [currentTime]);\n+\n+    const formattedDate = useMemo(() => {\n+        return currentTime.toLocaleDateString('en-US', {\n+            weekday: 'short',\n+            month: 'short',\n+            day: 'numeric',\n+        });\n+    }, [currentTime]);\n+\n+    // Order agents for display\n+    const orderedAgents = useMemo(() => {\n+        return AGENT_ORDER.map((id) => agents[id]).filter(Boolean);\n+    }, [agents]);\n+\n+    // Loading state (wait for hydration)\n+    if (!isHydrated) {\n+        return (\n+            <div className={styles.loading}>\n+                <div className={styles.spinner} />\n+                <span className={styles.loadingText}>Initializing Activity Feed</span>\n+            </div>\n+        );\n+    }\n+\n+    return (\n+        <div className={styles.container}>\n+            {/* Unified top bar: title + stats + clock */}\n+            <div className={styles.topBar}>\n+                <h1 className={styles.title}>\n+                    <Activity size={16} style={{ display: 'inline', marginRight: 4 }} />\n+                    Activity Feed\n+                </h1>\n+                <ActivityStats\n+                onlineCount={onlineCount}\n+                busyCount={busyCount}\n+                activeCount={activeCount}\n+                totalAgents={6}\n+                pendingPermissions={permissions.length}\n+                actionsToday={actionsToday}\n+                lastActivity={lastActivity}\n+                isConnected={isConnected}\n+                totalApproved={totalApproved}\n+                totalRejected={totalRejected}\n+                permissionStatsByAgent={permissionStatsByAgent}\n+                toolExecutions={toolExecutions}\n+                toolSuccesses={toolSuccesses}\n+                toolFailures={toolFailures}\n+                loopState={loopState}\n+                loopLoading={loopLoading}\n+                onStartLoop={startLoop}\n+                onStopLoop={stopLoop}\n+            />\n+                <button\n+                    className={`${styles.masterRefresh} ${isRefreshing ? styles.refreshSpin : ''}`}\n+                    onClick={handleMasterRefresh}\n+                    disabled={isRefreshing}\n+                    title=\"Refresh all feeds\"\n+                >\n+                    <RefreshCw size={14} />\n+                    <span className={styles.refreshLabel}>Sync</span>\n+                </button>\n+                <div className={styles.clockSection}>\n+                    <span className={styles.clockTime}>{formattedTime}</span>\n+                    <span className={styles.clockDate}>{formattedDate}</span>\n+                </div>\n+            </div>\n+\n+            {/* Master Broadcast Input */}\n+            <div className={styles.broadcastSection}>\n+                <div className={styles.broadcastIcon}>\n+                    <Radio size={18} />\n+                </div>\n+                <div className={styles.broadcastInputWrapper}>\n+                    <span className={styles.broadcastLabel}>Broadcast to All Agents</span>\n+                    <input\n+                        ref={broadcastInputRef}\n+                        type=\"text\"\n+                        className={styles.broadcastInput}\n+                        placeholder={isConnected\n+                            ? \"Type a command to send to all 6 terminals...\"\n+                            : \"Type a command (will send when connected)...\"\n+                        }\n+                        value={broadcastValue}\n+                        onChange={(e) => setBroadcastValue(e.target.value)}\n+                        onKeyDown={handleBroadcastKeyDown}\n+                    />\n+                </div>\n+                <button\n+                    className={styles.broadcastButton}\n+                    onClick={handleBroadcast}\n+                    disabled={!broadcastValue.trim()}\n+                >\n+                    <Send size={14} />\n+                    Broadcast\n+                </button>\n+            </div>\n+\n+            {/* Agent Terminals - 2x3 Grid (full width) */}\n+            <div className={styles.agentGrid}>\n+                {orderedAgents.map((agent) => (\n+                    <AgentTerminal\n+                        key={agent.id}\n+                        agent={agent}\n+                        onSendCommand={sendCommand}\n+                        heartbeat={heartbeat[agent.id]}\n+                        onNudge={nudgeAgent}\n+                    />\n+                ))}\n+            </div>\n+\n+            {/* Jira Ticket Strip - Bottom Row */}\n+            <div className={styles.ticketStripWrapper}>\n+                <TicketStrip\n+                    tickets={tickets}\n+                    isLoading={ticketsLoading}\n+                    onTransition={handleTicketTransition}\n+                />\n+            </div>\n+        </div>\n+    );\n+}\ndiff --git a/src/components/ActivityFeed/ActivityStats.module.css b/src/components/ActivityFeed/ActivityStats.module.css\nnew file mode 100644\nindex 0000000..0c57044\n--- /dev/null\n+++ b/src/components/ActivityFeed/ActivityStats.module.css\n@@ -0,0 +1,323 @@\n+.statsBar {\n+    display: flex;\n+    align-items: center;\n+    gap: 12px;\n+    padding: 4px 10px;\n+    background: transparent;\n+    border: none;\n+    border-radius: 0;\n+    margin-bottom: 0;\n+    flex: 1;\n+    min-width: 0;\n+}\n+\n+/* Connection Status */\n+.connectionStatus {\n+    display: flex;\n+    align-items: center;\n+    gap: 6px;\n+    padding: 4px 10px;\n+    background: rgba(255, 255, 255, 0.03);\n+    border: 1px solid rgba(255, 255, 255, 0.06);\n+    border-radius: 6px;\n+}\n+\n+.connectionDot {\n+    width: 8px;\n+    height: 8px;\n+    border-radius: 50%;\n+    transition: all 0.3s ease;\n+}\n+\n+.connectionDot.connected {\n+    background: #10b981;\n+    box-shadow: 0 0 8px #10b981;\n+    animation: pulse 2s ease-in-out infinite;\n+}\n+\n+.connectionDot.disconnected {\n+    background: #ef4444;\n+    box-shadow: 0 0 8px #ef4444;\n+}\n+\n+.connectionText {\n+    font-size: 12px;\n+    font-weight: 700;\n+    font-family: 'JetBrains Mono', 'Consolas', monospace;\n+    letter-spacing: 0.1em;\n+    color: rgba(255, 255, 255, 0.6);\n+}\n+\n+/* Stats Grid */\n+.statsGrid {\n+    display: flex;\n+    align-items: center;\n+    gap: 32px;\n+    flex: 1;\n+}\n+\n+.stat {\n+    display: flex;\n+    align-items: center;\n+    gap: 10px;\n+    padding: 6px 12px;\n+    border-radius: 8px;\n+    transition: all 0.2s ease;\n+}\n+\n+.stat:hover {\n+    background: rgba(255, 255, 255, 0.03);\n+}\n+\n+.stat.alert {\n+    background: rgba(239, 68, 68, 0.08);\n+    border: 1px solid rgba(239, 68, 68, 0.2);\n+}\n+\n+.statIcon {\n+    color: rgba(255, 255, 255, 0.4);\n+    flex-shrink: 0;\n+}\n+\n+.stat.alert .statIcon {\n+    color: #ef4444;\n+}\n+\n+.statContent {\n+    display: flex;\n+    flex-direction: column;\n+    gap: 2px;\n+}\n+\n+.statLabel {\n+    font-size: 12px;\n+    font-weight: 600;\n+    text-transform: uppercase;\n+    letter-spacing: 0.08em;\n+    color: rgba(255, 255, 255, 0.4);\n+}\n+\n+.statValue {\n+    font-size: 16px;\n+    font-weight: 700;\n+    font-family: 'JetBrains Mono', 'Consolas', monospace;\n+    color: rgba(255, 255, 255, 0.85);\n+}\n+\n+.statValue .highlight {\n+    color: #10b981;\n+}\n+\n+.statValue .muted {\n+    color: rgba(255, 255, 255, 0.4);\n+}\n+\n+.statValue .divider {\n+    color: rgba(255, 255, 255, 0.2);\n+    margin: 0 2px;\n+}\n+\n+.statValue .total {\n+    color: rgba(255, 255, 255, 0.4);\n+    font-size: 16px;\n+}\n+\n+.alertValue {\n+    color: #ef4444 !important;\n+    animation: alertPulse 1.5s ease-in-out infinite;\n+}\n+\n+/* Approval Stats */\n+.approvalStat {\n+    cursor: help;\n+}\n+\n+.statIconSuccess {\n+    color: #10b981;\n+    flex-shrink: 0;\n+}\n+\n+.approvedCount {\n+    color: #10b981;\n+    font-weight: 700;\n+}\n+\n+.rejectedCount {\n+    color: #ef4444;\n+    font-weight: 700;\n+}\n+\n+/* Busy Indicator */\n+.busyIndicator {\n+    display: inline-flex;\n+    align-items: center;\n+    gap: 2px;\n+    margin-left: 6px;\n+    padding: 2px 6px;\n+    background: rgba(251, 191, 36, 0.15);\n+    border: 1px solid rgba(251, 191, 36, 0.3);\n+    border-radius: 4px;\n+    font-size: 11px;\n+    color: #fbbf24;\n+    animation: busyPulse 1.5s ease-in-out infinite;\n+}\n+\n+@keyframes busyPulse {\n+    0%, 100% {\n+        opacity: 1;\n+    }\n+    50% {\n+        opacity: 0.6;\n+    }\n+}\n+\n+/* Animations */\n+@keyframes pulse {\n+    0%, 100% {\n+        opacity: 1;\n+    }\n+    50% {\n+        opacity: 0.5;\n+    }\n+}\n+\n+@keyframes alertPulse {\n+    0%, 100% {\n+        opacity: 1;\n+        transform: scale(1);\n+    }\n+    50% {\n+        opacity: 0.8;\n+        transform: scale(1.05);\n+    }\n+}\n+\n+/* Responsive */\n+@media (max-width: 1200px) {\n+    .statsBar {\n+        flex-wrap: wrap;\n+    }\n+\n+    .statsGrid {\n+        gap: 20px;\n+    }\n+}\n+\n+@media (max-width: 768px) {\n+    .statsBar {\n+        flex-direction: column;\n+        align-items: stretch;\n+        gap: 12px;\n+    }\n+\n+    .statsGrid {\n+        display: grid;\n+        grid-template-columns: repeat(2, 1fr);\n+        gap: 12px;\n+    }\n+}\n+\n+/* ═══════════════════════════════════════════════════════════════════════════\n+   Loop Control Section - Jira agent loop controls\n+   ═══════════════════════════════════════════════════════════════════════════ */\n+\n+.loopSection {\n+    display: flex;\n+    align-items: center;\n+    gap: 16px;\n+    padding: 10px 14px;\n+    background: rgba(17, 17, 22, 0.7);\n+    backdrop-filter: blur(8px);\n+    border: 1px solid rgba(255, 255, 255, 0.06);\n+    border-radius: 8px;\n+    margin-left: auto;\n+}\n+\n+.loopStatus {\n+    display: flex;\n+    flex-direction: column;\n+    gap: 2px;\n+}\n+\n+.loopRunning {\n+    font-size: 12px;\n+    font-weight: 700;\n+    font-family: 'JetBrains Mono', 'Consolas', monospace;\n+    letter-spacing: 0.08em;\n+    text-transform: uppercase;\n+    color: hsl(142 76% 36%);\n+    text-shadow: 0 0 8px hsla(142, 76%, 36%, 0.5);\n+}\n+\n+.loopStopped {\n+    font-size: 12px;\n+    font-weight: 700;\n+    font-family: 'JetBrains Mono', 'Consolas', monospace;\n+    letter-spacing: 0.08em;\n+    text-transform: uppercase;\n+    color: hsl(0 84% 60%);\n+}\n+\n+.currentIssue {\n+    font-size: 11px;\n+    color: rgba(255, 255, 255, 0.4);\n+    font-family: 'JetBrains Mono', 'Consolas', monospace;\n+}\n+\n+.loopButtons {\n+    display: flex;\n+    flex-direction: row;\n+    gap: 8px;\n+}\n+\n+.startButton {\n+    display: flex;\n+    align-items: center;\n+    justify-content: center;\n+    gap: 6px;\n+    padding: 6px 12px;\n+    font-size: 0.875rem;\n+    font-weight: 600;\n+    color: #ffffff;\n+    background: hsl(188 95% 43%);\n+    border: none;\n+    border-radius: 6px;\n+    cursor: pointer;\n+    transition: all 0.2s ease;\n+}\n+\n+.startButton:hover:not(:disabled) {\n+    background: hsl(188 95% 48%);\n+    box-shadow: 0 0 12px hsla(188, 95%, 43%, 0.4);\n+}\n+\n+.startButton:disabled {\n+    opacity: 0.5;\n+    cursor: not-allowed;\n+}\n+\n+.stopButton {\n+    display: flex;\n+    align-items: center;\n+    justify-content: center;\n+    gap: 6px;\n+    padding: 6px 12px;\n+    font-size: 0.875rem;\n+    font-weight: 600;\n+    color: hsl(0 84% 60%);\n+    background: transparent;\n+    border: 1px solid hsl(0 84% 60%);\n+    border-radius: 6px;\n+    cursor: pointer;\n+    transition: all 0.2s ease;\n+}\n+\n+.stopButton:hover:not(:disabled) {\n+    background: hsla(0, 84%, 60%, 0.1);\n+    box-shadow: 0 0 12px hsla(0, 84%, 60%, 0.3);\n+}\n+\n+.stopButton:disabled {\n+    opacity: 0.5;\n+    cursor: not-allowed;\n+}\ndiff --git a/src/components/ActivityFeed/ActivityStats.tsx b/src/components/ActivityFeed/ActivityStats.tsx\nnew file mode 100644\nindex 0000000..b2358c2\n--- /dev/null\n+++ b/src/components/ActivityFeed/ActivityStats.tsx\n@@ -0,0 +1,164 @@\n+'use client';\n+\n+import React from 'react';\n+import { Activity, Users, Clock, AlertCircle, CheckCircle, Terminal, Zap } from 'lucide-react';\n+import styles from './ActivityStats.module.css';\n+import type { PermissionStats } from '@/hooks/useActivityFeed';\n+\n+interface ActivityStatsProps {\n+    onlineCount: number;\n+    busyCount: number;\n+    activeCount: number;\n+    totalAgents: number;\n+    pendingPermissions: number;\n+    actionsToday: number;\n+    lastActivity: string | null;\n+    isConnected: boolean;\n+    totalApproved: number;\n+    totalRejected: number;\n+    permissionStatsByAgent: Record<string, PermissionStats>;\n+    // Tool execution stats (for agents running with --dangerously-skip-permissions)\n+    toolExecutions?: number;\n+    toolSuccesses?: number;\n+    toolFailures?: number;\n+}\n+\n+function formatTimeAgo(isoString: string | null): string {\n+    if (!isoString) return 'N/A';\n+\n+    const diff = Date.now() - new Date(isoString).getTime();\n+    const seconds = Math.floor(diff / 1000);\n+\n+    if (seconds < 5) return 'just now';\n+    if (seconds < 60) return `${seconds}s ago`;\n+\n+    const minutes = Math.floor(seconds / 60);\n+    if (minutes < 60) return `${minutes}m ago`;\n+\n+    const hours = Math.floor(minutes / 60);\n+    if (hours < 24) return `${hours}h ago`;\n+\n+    const days = Math.floor(hours / 24);\n+    return `${days}d ago`;\n+}\n+\n+export function ActivityStats({\n+    onlineCount,\n+    busyCount,\n+    activeCount,\n+    totalAgents,\n+    pendingPermissions,\n+    actionsToday,\n+    lastActivity,\n+    isConnected,\n+    totalApproved,\n+    totalRejected,\n+    permissionStatsByAgent,\n+    toolExecutions = 0,\n+    toolSuccesses = 0,\n+    toolFailures = 0,\n+}: ActivityStatsProps) {\n+    // Calculate agent breakdown for tooltip\n+    const agentBreakdown = Object.entries(permissionStatsByAgent)\n+        .filter(([_, stats]) => stats.approved > 0 || stats.rejected > 0)\n+        .map(([agent, stats]) => `${agent}: ${stats.approved}✓ ${stats.rejected}✗`)\n+        .join(' | ');\n+\n+    // Show tool executions if agents are running in auto-mode (skip permissions)\n+    const hasToolActivity = toolExecutions > 0 || toolSuccesses > 0 || toolFailures > 0;\n+    const hasManualApprovals = totalApproved > 0 || totalRejected > 0;\n+\n+    return (\n+        <div className={styles.statsBar}>\n+            {/* Connection Status */}\n+            <div className={styles.connectionStatus}>\n+                <div className={`${styles.connectionDot} ${isConnected ? styles.connected : styles.disconnected}`} />\n+                <span className={styles.connectionText}>\n+                    {isConnected ? 'CONNECTED' : 'OFFLINE'}\n+                </span>\n+            </div>\n+\n+            {/* Stats Grid */}\n+            <div className={styles.statsGrid}>\n+                {/* Agents Active (online + busy) */}\n+                <div className={styles.stat}>\n+                    <Users size={16} className={styles.statIcon} />\n+                    <div className={styles.statContent}>\n+                        <span className={styles.statLabel}>Active Agents</span>\n+                        <span className={styles.statValue}>\n+                            <span className={activeCount > 0 ? styles.highlight : styles.muted}>\n+                                {activeCount}\n+                            </span>\n+                            <span className={styles.divider}>/</span>\n+                            <span className={styles.total}>{totalAgents}</span>\n+                            {busyCount > 0 && (\n+                                <span className={styles.busyIndicator} title={`${busyCount} busy`}>\n+                                    <Zap size={12} />\n+                                    {busyCount}\n+                                </span>\n+                            )}\n+                        </span>\n+                    </div>\n+                </div>\n+\n+                {/* Pending Permissions */}\n+                <div className={`${styles.stat} ${pendingPermissions > 0 ? styles.alert : ''}`}>\n+                    <AlertCircle size={16} className={styles.statIcon} />\n+                    <div className={styles.statContent}>\n+                        <span className={styles.statLabel}>Pending</span>\n+                        <span className={`${styles.statValue} ${pendingPermissions > 0 ? styles.alertValue : ''}`}>\n+                            {pendingPermissions}\n+                        </span>\n+                    </div>\n+                </div>\n+\n+                {/* Tool Executions (auto-mode) or Manual Approvals */}\n+                {hasToolActivity || !hasManualApprovals ? (\n+                    <div className={`${styles.stat} ${styles.approvalStat}`} title={`${toolExecutions} tool calls (${toolSuccesses} succeeded, ${toolFailures} failed)`}>\n+                        <Terminal size={16} className={styles.statIconSuccess} />\n+                        <div className={styles.statContent}>\n+                            <span className={styles.statLabel}>Tool Calls ✓/✗</span>\n+                            <span className={styles.statValue}>\n+                                <span className={styles.approvedCount}>{toolSuccesses}</span>\n+                                <span className={styles.divider}>/</span>\n+                                <span className={styles.rejectedCount}>{toolFailures}</span>\n+                            </span>\n+                        </div>\n+                    </div>\n+                ) : (\n+                    <div className={`${styles.stat} ${styles.approvalStat}`} title={agentBreakdown || 'No approvals/rejections yet'}>\n+                        <CheckCircle size={16} className={styles.statIconSuccess} />\n+                        <div className={styles.statContent}>\n+                            <span className={styles.statLabel}>Approved / Denied</span>\n+                            <span className={styles.statValue}>\n+                                <span className={styles.approvedCount}>{totalApproved}</span>\n+                                <span className={styles.divider}>/</span>\n+                                <span className={styles.rejectedCount}>{totalRejected}</span>\n+                            </span>\n+                        </div>\n+                    </div>\n+                )}\n+\n+                {/* Actions Today */}\n+                <div className={styles.stat}>\n+                    <Activity size={16} className={styles.statIcon} />\n+                    <div className={styles.statContent}>\n+                        <span className={styles.statLabel}>Actions Today</span>\n+                        <span className={styles.statValue}>{actionsToday.toLocaleString()}</span>\n+                    </div>\n+                </div>\n+\n+                {/* Last Activity */}\n+                <div className={styles.stat}>\n+                    <Clock size={16} className={styles.statIcon} />\n+                    <div className={styles.statContent}>\n+                        <span className={styles.statLabel}>Last Activity</span>\n+                        <span className={styles.statValue}>{formatTimeAgo(lastActivity)}</span>\n+                    </div>\n+                </div>\n+            </div>\n+        </div>\n+    );\n+}\n+\n+export default ActivityStats;\ndiff --git a/src/components/ActivityFeed/AgentTerminal.module.css b/src/components/ActivityFeed/AgentTerminal.module.css\nnew file mode 100644\nindex 0000000..124b6b6\n--- /dev/null\n+++ b/src/components/ActivityFeed/AgentTerminal.module.css\n@@ -0,0 +1,534 @@\n+.terminalWindow {\n+    display: flex;\n+    flex-direction: column;\n+    background: rgba(9, 9, 11, 0.95);\n+    backdrop-filter: blur(12px);\n+    border: 1px solid rgba(255, 255, 255, 0.08);\n+    border-radius: 12px;\n+    overflow: hidden;\n+    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);\n+    height: 100%;\n+    min-height: 0;\n+    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;\n+    transition: all 0.2s ease;\n+}\n+\n+.terminalWindow:hover {\n+    border-color: var(--agent-color, rgba(255, 255, 255, 0.15));\n+    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5), 0 0 0 1px var(--agent-color, transparent);\n+}\n+\n+/* Header */\n+.header {\n+    display: flex;\n+    align-items: center;\n+    justify-content: space-between;\n+    padding: 10px 12px;\n+    background: rgba(24, 24, 27, 0.95);\n+    border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n+}\n+\n+.headerLeft {\n+    display: flex;\n+    align-items: center;\n+    gap: 8px;\n+}\n+\n+.avatarWrapper {\n+    width: 40px;\n+    height: 40px;\n+    border-radius: 50%;\n+    border: 2px solid var(--agent-color, #06b6d4);\n+    overflow: hidden;\n+    flex-shrink: 0;\n+    box-shadow: 0 0 8px rgba(0, 0, 0, 0.4), 0 0 12px var(--agent-color, transparent);\n+}\n+\n+.avatar {\n+    width: 100%;\n+    height: 100%;\n+    object-fit: cover;\n+    border-radius: 50%;\n+}\n+\n+.emoji {\n+    font-size: 24px;\n+}\n+\n+.headerInfo {\n+    display: flex;\n+    flex-direction: column;\n+    gap: 1px;\n+}\n+\n+.terminalIcon {\n+    color: rgba(255, 255, 255, 0.4);\n+}\n+\n+.title {\n+    font-size: 14px;\n+    font-weight: 600;\n+    letter-spacing: 0.08em;\n+    color: rgba(255, 255, 255, 0.7);\n+}\n+\n+.titleSub {\n+    font-size: 10px;\n+    font-weight: 500;\n+    letter-spacing: 0.12em;\n+    color: rgba(255, 255, 255, 0.3);\n+    text-transform: uppercase;\n+}\n+\n+.headerRight {\n+    display: flex;\n+    align-items: center;\n+}\n+\n+/* Heartbeat Indicator */\n+.heartbeat {\n+    display: flex;\n+    align-items: center;\n+    gap: 4px;\n+    padding: 3px 8px;\n+    border-radius: 10px;\n+    font-size: 8px;\n+    font-weight: 600;\n+    letter-spacing: 0.08em;\n+    margin-right: 6px;\n+}\n+\n+.heartbeatDot {\n+    width: 6px;\n+    height: 6px;\n+    border-radius: 50%;\n+}\n+\n+.heartbeatAlive {\n+    background: rgba(34, 197, 94, 0.15);\n+}\n+\n+.heartbeatAlive .heartbeatDot {\n+    background: #22c55e;\n+    animation: heartbeatPulse 2s ease-in-out infinite;\n+}\n+\n+.heartbeatStale {\n+    background: rgba(251, 191, 36, 0.2);\n+    color: #fbbf24;\n+}\n+\n+.heartbeatStale .heartbeatDot {\n+    background: #fbbf24;\n+    animation: heartbeatSlow 3s ease-in-out infinite;\n+}\n+\n+.heartbeatDead {\n+    background: rgba(239, 68, 68, 0.2);\n+    color: #ef4444;\n+}\n+\n+.heartbeatDead .heartbeatDot {\n+    background: #ef4444;\n+}\n+\n+.heartbeatUnknown {\n+    background: rgba(107, 114, 128, 0.15);\n+    color: #6b7280;\n+}\n+\n+.heartbeatUnknown .heartbeatDot {\n+    background: #6b7280;\n+}\n+\n+.heartbeatLabel {\n+    text-transform: uppercase;\n+}\n+\n+/* Wake Button */\n+.wakeButton {\n+    display: flex;\n+    align-items: center;\n+    gap: 4px;\n+    padding: 4px 8px;\n+    border-radius: 8px;\n+    font-size: 9px;\n+    font-weight: 600;\n+    letter-spacing: 0.05em;\n+    background: rgba(251, 191, 36, 0.2);\n+    border: 1px solid rgba(251, 191, 36, 0.4);\n+    color: #fbbf24;\n+    cursor: pointer;\n+    transition: all 0.2s ease;\n+    margin-right: 6px;\n+}\n+\n+.wakeButton:hover {\n+    background: rgba(251, 191, 36, 0.3);\n+    border-color: #fbbf24;\n+    transform: scale(1.05);\n+}\n+\n+.wakeButton:active {\n+    transform: scale(0.98);\n+}\n+\n+@keyframes heartbeatPulse {\n+    0%, 100% {\n+        transform: scale(1);\n+        opacity: 1;\n+    }\n+    50% {\n+        transform: scale(1.3);\n+        opacity: 0.7;\n+    }\n+}\n+\n+@keyframes heartbeatSlow {\n+    0%, 100% {\n+        opacity: 1;\n+    }\n+    50% {\n+        opacity: 0.4;\n+    }\n+}\n+\n+/* Status Badge */\n+.status {\n+    display: flex;\n+    align-items: center;\n+    gap: 6px;\n+    padding: 5px 12px;\n+    border-radius: 12px;\n+    font-size: 11px;\n+    font-weight: 700;\n+    letter-spacing: 0.1em;\n+}\n+\n+.status.online {\n+    background: rgba(34, 197, 94, 0.15);\n+    color: #22c55e;\n+}\n+\n+.status.online .statusDot {\n+    animation: pulse 2s ease-in-out infinite;\n+}\n+\n+.status.busy {\n+    background: rgba(251, 191, 36, 0.15);\n+    color: #fbbf24;\n+}\n+\n+.status.busy .statusDot {\n+    animation: blink 1s ease-in-out infinite;\n+}\n+\n+.status.offline {\n+    background: rgba(107, 114, 128, 0.15);\n+    color: #6b7280;\n+}\n+\n+.statusDot {\n+    width: 6px;\n+    height: 6px;\n+}\n+\n+.statusText {\n+    text-transform: uppercase;\n+}\n+\n+/* Terminal Content */\n+.content {\n+    flex: 1;\n+    padding: 8px 12px;\n+    overflow-y: auto;\n+    font-size: 13px;\n+    display: flex;\n+    flex-direction: column;\n+    gap: 3px;\n+    background: rgba(9, 9, 11, 0.98);\n+    line-height: 1.5;\n+    min-height: 0;\n+}\n+\n+/* Scrollbar */\n+.content::-webkit-scrollbar {\n+    width: 6px;\n+}\n+\n+.content::-webkit-scrollbar-track {\n+    background: transparent;\n+}\n+\n+.content::-webkit-scrollbar-thumb {\n+    background: rgba(255, 255, 255, 0.1);\n+    border-radius: 3px;\n+}\n+\n+.content::-webkit-scrollbar-thumb:hover {\n+    background: rgba(255, 255, 255, 0.2);\n+}\n+\n+/* Empty State */\n+.emptyState {\n+    flex: 1;\n+    display: flex;\n+    flex-direction: column;\n+    align-items: center;\n+    justify-content: center;\n+    gap: 12px;\n+    color: rgba(255, 255, 255, 0.25);\n+}\n+\n+.emptyIcon {\n+    font-size: 24px;\n+    opacity: 0.4;\n+}\n+\n+.emptyAvatarWrapper {\n+    width: 48px;\n+    height: 48px;\n+    border-radius: 50%;\n+    overflow: hidden;\n+    opacity: 0.4;\n+    filter: grayscale(0.5);\n+}\n+\n+.emptyText {\n+    font-size: 11px;\n+    font-style: italic;\n+    letter-spacing: 0.05em;\n+}\n+\n+/* Log Lines */\n+.logLine {\n+    display: flex;\n+    gap: 6px;\n+    align-items: flex-start;\n+    padding: 4px 6px;\n+    border-radius: 4px;\n+    animation: fadeIn 0.2s ease;\n+    transition: background 0.15s ease;\n+}\n+\n+.logLine:hover {\n+    background: rgba(255, 255, 255, 0.03);\n+}\n+\n+.timestamp {\n+    color: rgba(255, 255, 255, 0.3);\n+    font-size: 11px;\n+    min-width: 55px;\n+    max-width: 55px;\n+    font-feature-settings: \"tnum\" 1;\n+    flex-shrink: 0;\n+}\n+\n+.icon {\n+    min-width: 16px;\n+    max-width: 16px;\n+    text-align: center;\n+    font-size: 12px;\n+    flex-shrink: 0;\n+}\n+\n+.message {\n+    color: rgba(255, 255, 255, 0.85);\n+    word-break: break-word;\n+    flex: 1;\n+    min-width: 0;\n+    line-height: 1.5;\n+    font-size: 13px;\n+}\n+\n+/* Log Levels */\n+.logLine.info .message {\n+    color: rgba(255, 255, 255, 0.7);\n+}\n+\n+.logLine.warn .message {\n+    color: #fde047;\n+}\n+\n+.logLine.success .message {\n+    color: #86efac;\n+}\n+\n+.logLine.error .message {\n+    color: #f87171;\n+}\n+\n+.logLine.action .message {\n+    color: #60a5fa;\n+    font-weight: 600;\n+}\n+\n+/* Input Section */\n+.inputSection {\n+    display: flex;\n+    align-items: center;\n+    gap: 6px;\n+    padding: 6px 8px;\n+    background: rgba(24, 24, 27, 0.95);\n+    border-top: 1px solid rgba(255, 255, 255, 0.06);\n+}\n+\n+.inputPrompt {\n+    display: flex;\n+    align-items: center;\n+    gap: 4px;\n+    color: var(--agent-color, #06b6d4);\n+    font-size: 14px;\n+    font-weight: 600;\n+    user-select: none;\n+}\n+\n+.inputAvatar {\n+    width: 18px;\n+    height: 18px;\n+    border-radius: 50%;\n+    object-fit: cover;\n+}\n+\n+.input {\n+    flex: 1;\n+    background: rgba(9, 9, 11, 0.8);\n+    border: 1px solid rgba(255, 255, 255, 0.1);\n+    border-radius: 5px;\n+    padding: 6px 10px;\n+    font-family: inherit;\n+    font-size: 13px;\n+    color: rgba(255, 255, 255, 0.9);\n+    outline: none;\n+    transition: border-color 0.2s ease, box-shadow 0.2s ease;\n+}\n+\n+.input::placeholder {\n+    color: rgba(255, 255, 255, 0.3);\n+}\n+\n+.input:focus {\n+    border-color: var(--agent-color, #06b6d4);\n+    box-shadow: 0 0 0 2px rgba(6, 182, 212, 0.15);\n+}\n+\n+.sendButton {\n+    display: flex;\n+    align-items: center;\n+    justify-content: center;\n+    width: 26px;\n+    height: 26px;\n+    background: var(--agent-color, #06b6d4);\n+    border: none;\n+    border-radius: 6px;\n+    cursor: pointer;\n+    color: #000;\n+    transition: all 0.2s ease;\n+}\n+\n+.sendButton:hover {\n+    transform: scale(1.05);\n+    filter: brightness(1.1);\n+}\n+\n+.sendButton:disabled {\n+    opacity: 0.5;\n+    cursor: not-allowed;\n+    transform: none;\n+}\n+\n+/* Pending command indicator */\n+.pendingCommand {\n+    display: flex;\n+    align-items: center;\n+    gap: 8px;\n+    padding: 6px 10px;\n+    background: rgba(251, 191, 36, 0.1);\n+    border-radius: 4px;\n+    font-size: 11px;\n+    color: #fbbf24;\n+    animation: fadeIn 0.2s ease;\n+}\n+\n+.pendingSpinner {\n+    width: 12px;\n+    height: 12px;\n+    border: 2px solid rgba(251, 191, 36, 0.3);\n+    border-top-color: #fbbf24;\n+    border-radius: 50%;\n+    animation: spin 1s linear infinite;\n+}\n+\n+@keyframes spin {\n+    to {\n+        transform: rotate(360deg);\n+    }\n+}\n+\n+/* Accent Bar */\n+.accentBar {\n+    height: 2px;\n+    opacity: 0.6;\n+    transition: opacity 0.2s ease;\n+}\n+\n+.terminalWindow:hover .accentBar {\n+    opacity: 1;\n+}\n+\n+/* Animations */\n+@keyframes pulse {\n+    0%, 100% {\n+        opacity: 1;\n+    }\n+    50% {\n+        opacity: 0.4;\n+    }\n+}\n+\n+@keyframes blink {\n+    0%, 100% {\n+        opacity: 1;\n+    }\n+    50% {\n+        opacity: 0.2;\n+    }\n+}\n+\n+@keyframes fadeIn {\n+    from {\n+        opacity: 0;\n+        transform: translateY(2px);\n+    }\n+    to {\n+        opacity: 1;\n+        transform: translateY(0);\n+    }\n+}\n+\n+/* Theme Overrides */\n+:global([data-theme='light']) .terminalWindow {\n+    background: rgba(255, 255, 255, 0.9);\n+    border-color: rgba(0, 0, 0, 0.1);\n+}\n+\n+:global([data-theme='light']) .header {\n+    background: rgba(241, 245, 249, 0.95);\n+    border-color: rgba(0, 0, 0, 0.06);\n+}\n+\n+:global([data-theme='light']) .content {\n+    background: rgba(248, 250, 252, 0.98);\n+}\n+\n+:global([data-theme='light']) .title {\n+    color: rgba(0, 0, 0, 0.7);\n+}\n+\n+:global([data-theme='light']) .message {\n+    color: rgba(0, 0, 0, 0.8);\n+}\n+\n+:global([data-theme='light']) .timestamp {\n+    color: rgba(0, 0, 0, 0.4);\n+}\ndiff --git a/src/components/ActivityFeed/AgentTerminal.tsx b/src/components/ActivityFeed/AgentTerminal.tsx\nnew file mode 100644\nindex 0000000..7e01164\n--- /dev/null\n+++ b/src/components/ActivityFeed/AgentTerminal.tsx\n@@ -0,0 +1,375 @@\n+'use client';\n+\n+import React, { useEffect, useRef, useState, useCallback, KeyboardEvent } from 'react';\n+import Image from 'next/image';\n+import { Terminal, Circle, Send, Zap } from 'lucide-react';\n+import styles from './AgentTerminal.module.css';\n+import type { AgentState, LogEntry, AgentStatus, HeartbeatAgentState } from '@/hooks/useActivityFeed';\n+\n+interface AgentTerminalProps {\n+    agent: AgentState;\n+    onSendCommand?: (agentId: string, command: string) => void;\n+    heartbeat?: HeartbeatAgentState;\n+    onNudge?: (agentId: string) => void;\n+}\n+\n+// ANSI color code mapping\n+const ANSI_COLORS: Record<string, string> = {\n+    '\\x1b[30m': '#1e1e1e', // black\n+    '\\x1b[31m': '#ef4444', // red\n+    '\\x1b[32m': '#22c55e', // green\n+    '\\x1b[33m': '#fbbf24', // yellow\n+    '\\x1b[34m': '#3b82f6', // blue\n+    '\\x1b[35m': '#a855f7', // magenta\n+    '\\x1b[36m': '#06b6d4', // cyan\n+    '\\x1b[37m': '#e5e5e5', // white\n+    '\\x1b[90m': '#6b7280', // bright black (gray)\n+    '\\x1b[91m': '#f87171', // bright red\n+    '\\x1b[92m': '#4ade80', // bright green\n+    '\\x1b[93m': '#fde047', // bright yellow\n+    '\\x1b[94m': '#60a5fa', // bright blue\n+    '\\x1b[95m': '#c084fc', // bright magenta\n+    '\\x1b[96m': '#22d3ee', // bright cyan\n+    '\\x1b[97m': '#ffffff', // bright white\n+    '\\x1b[0m': '',         // reset\n+};\n+\n+function stringifyMessage(input: unknown): string {\n+    if (typeof input === 'string') {\n+        return input;\n+    }\n+    if (input === null || input === undefined) {\n+        return '';\n+    }\n+    if (typeof input === 'object') {\n+        try {\n+            // For objects, try to extract meaningful text\n+            const obj = input as Record<string, unknown>;\n+            // Check for common message fields\n+            if ('message' in obj && typeof obj.message === 'string') {\n+                return obj.message;\n+            }\n+            if ('text' in obj && typeof obj.text === 'string') {\n+                return obj.text;\n+            }\n+            if ('line' in obj && typeof obj.line === 'string') {\n+                return obj.line;\n+            }\n+            if ('content' in obj && typeof obj.content === 'string') {\n+                return obj.content;\n+            }\n+            // Fallback to JSON\n+            return JSON.stringify(input, null, 0);\n+        } catch {\n+            return String(input);\n+        }\n+    }\n+    return String(input);\n+}\n+\n+// Format log message for display - truncate long messages and highlight prefixes\n+function formatLogMessage(text: string): { prefix: string | null; content: string } {\n+    // Check for common prefixes like [USER], [TOOL], [RESULT]\n+    const prefixMatch = text.match(/^\\[([A-Z]+)\\]\\s*/);\n+    if (prefixMatch) {\n+        return {\n+            prefix: prefixMatch[1],\n+            content: text.substring(prefixMatch[0].length).substring(0, 200),\n+        };\n+    }\n+    return { prefix: null, content: text.substring(0, 400) };\n+}\n+\n+function parseAnsiText(input: unknown): React.ReactNode[] {\n+    const text = stringifyMessage(input);\n+    // Truncate very long messages for readability (increased for raw terminal output)\n+    const truncatedText = text.length > 500 ? text.substring(0, 500) + '...' : text;\n+    const parts: React.ReactNode[] = [];\n+    let currentColor: string | null = null;\n+    let currentText = '';\n+    let i = 0;\n+\n+    while (i < truncatedText.length) {\n+        // Check for ANSI escape sequence\n+        if (truncatedText[i] === '\\x1b' && truncatedText[i + 1] === '[') {\n+            // Find the end of the sequence\n+            let seqEnd = i + 2;\n+            while (seqEnd < truncatedText.length && truncatedText[seqEnd] !== 'm') {\n+                seqEnd++;\n+            }\n+            if (seqEnd < truncatedText.length) {\n+                const seq = truncatedText.slice(i, seqEnd + 1);\n+\n+                // Push current accumulated text\n+                if (currentText) {\n+                    parts.push(\n+                        <span key={parts.length} style={currentColor ? { color: currentColor } : undefined}>\n+                            {currentText}\n+                        </span>\n+                    );\n+                    currentText = '';\n+                }\n+\n+                // Update color or reset\n+                if (seq === '\\x1b[0m') {\n+                    currentColor = null;\n+                } else if (ANSI_COLORS[seq]) {\n+                    currentColor = ANSI_COLORS[seq];\n+                }\n+\n+                i = seqEnd + 1;\n+                continue;\n+            }\n+        }\n+\n+        currentText += truncatedText[i];\n+        i++;\n+    }\n+\n+    // Push remaining text\n+    if (currentText) {\n+        parts.push(\n+            <span key={parts.length} style={currentColor ? { color: currentColor } : undefined}>\n+                {currentText}\n+            </span>\n+        );\n+    }\n+\n+    return parts.length > 0 ? parts : [truncatedText];\n+}\n+\n+function formatTimestamp(isoString: string): string {\n+    const date = new Date(isoString);\n+    return date.toLocaleTimeString('en-US', {\n+        hour12: false,\n+        hour: '2-digit',\n+        minute: '2-digit',\n+        second: '2-digit',\n+    });\n+}\n+\n+function getLogLevelIcon(level: LogEntry['level']): string {\n+    switch (level) {\n+        case 'SUCCESS': return '\\u2705';\n+        case 'ERROR': return '\\u274C';\n+        case 'WARN': return '\\u26A0\\uFE0F';\n+        case 'ACTION': return '\\u26A1';\n+        default: return '\\u203A';\n+    }\n+}\n+\n+function getStatusLabel(status: AgentStatus): string {\n+    switch (status) {\n+        case 'online': return 'ONLINE';\n+        case 'busy': return 'BUSY';\n+        case 'offline': return 'OFFLINE';\n+    }\n+}\n+\n+function formatLastSeen(isoString: string | null): string {\n+    if (!isoString) return 'Never';\n+    const diff = Date.now() - new Date(isoString).getTime();\n+    const seconds = Math.floor(diff / 1000);\n+    if (seconds < 60) return `${seconds}s ago`;\n+    const minutes = Math.floor(seconds / 60);\n+    if (minutes < 60) return `${minutes}m ago`;\n+    const hours = Math.floor(minutes / 60);\n+    return `${hours}h ago`;\n+}\n+\n+function getHeartbeatLabel(status: HeartbeatAgentState['status']): string {\n+    switch (status) {\n+        case 'alive': return '';\n+        case 'stale': return 'QUIET';\n+        case 'dead': return 'UNRESPONSIVE';\n+        default: return '';\n+    }\n+}\n+\n+export function AgentTerminal({ agent, onSendCommand, heartbeat, onNudge }: AgentTerminalProps) {\n+    const scrollRef = useRef<HTMLDivElement>(null);\n+    const inputRef = useRef<HTMLInputElement>(null);\n+    const [inputValue, setInputValue] = useState('');\n+    const [isPending, setIsPending] = useState(false);\n+\n+    const heartbeatStatus = heartbeat?.status || 'unknown';\n+    const isStaleOrDead = heartbeatStatus === 'stale' || heartbeatStatus === 'dead';\n+    const heartbeatLabel = getHeartbeatLabel(heartbeatStatus);\n+\n+    // Handle wake button click\n+    const handleNudge = useCallback(() => {\n+        if (onNudge) {\n+            onNudge(agent.id);\n+        }\n+    }, [agent.id, onNudge]);\n+\n+    // Auto-scroll to bottom when new logs arrive\n+    useEffect(() => {\n+        if (scrollRef.current) {\n+            scrollRef.current.scrollTop = scrollRef.current.scrollHeight;\n+        }\n+    }, [agent.logs]);\n+\n+    // Handle command submission\n+    const handleSubmit = useCallback(() => {\n+        const command = inputValue.trim();\n+        if (!command || !onSendCommand) return;\n+\n+        setIsPending(true);\n+        onSendCommand(agent.id, command);\n+        setInputValue('');\n+\n+        // Clear pending state after 3 seconds (command queue polling)\n+        setTimeout(() => setIsPending(false), 3000);\n+    }, [inputValue, agent.id, onSendCommand]);\n+\n+    // Handle keyboard shortcuts\n+    const handleKeyDown = useCallback((e: KeyboardEvent<HTMLInputElement>) => {\n+        if (e.key === 'Enter' && !e.shiftKey) {\n+            e.preventDefault();\n+            handleSubmit();\n+        }\n+    }, [handleSubmit]);\n+\n+    return (\n+        <div className={styles.terminalWindow} style={{ '--agent-color': agent.color } as React.CSSProperties}>\n+            {/* Color-coordinated Header */}\n+            <div className={styles.header} style={{ borderBottom: `2px solid ${agent.color}40` }}>\n+                <div className={styles.headerLeft}>\n+                    {agent.avatar ? (\n+                        <div className={styles.avatarWrapper} style={{ borderColor: agent.color }}>\n+                            <Image\n+                                src={agent.avatar}\n+                                alt={agent.name}\n+                                width={40}\n+                                height={40}\n+                                className={styles.avatar}\n+                                unoptimized\n+                            />\n+                        </div>\n+                    ) : (\n+                        <span className={styles.emoji}>{agent.emoji}</span>\n+                    )}\n+                    <div className={styles.headerInfo}>\n+                        <span className={styles.title} style={{ color: agent.color }}>{agent.name.toUpperCase()}</span>\n+                        <span className={styles.titleSub}>TERMINAL</span>\n+                    </div>\n+                </div>\n+                <div className={styles.headerRight}>\n+                    {/* Heartbeat indicator */}\n+                    {heartbeat && (\n+                        <div\n+                            className={`${styles.heartbeat} ${styles[`heartbeat${heartbeatStatus.charAt(0).toUpperCase() + heartbeatStatus.slice(1)}`]}`}\n+                            title={`Last seen: ${formatLastSeen(heartbeat.lastSeen)}${heartbeat.nudgeCount > 0 ? ` | Nudged ${heartbeat.nudgeCount}x` : ''}`}\n+                        >\n+                            <div className={styles.heartbeatDot} />\n+                            {heartbeatLabel && <span className={styles.heartbeatLabel}>{heartbeatLabel}</span>}\n+                        </div>\n+                    )}\n+\n+                    {/* Wake button for stale/dead agents */}\n+                    {isStaleOrDead && onNudge && (\n+                        <button\n+                            className={styles.wakeButton}\n+                            onClick={handleNudge}\n+                            title=\"Send wake-up ping to agent\"\n+                            style={{ '--agent-color': agent.color } as React.CSSProperties}\n+                        >\n+                            <Zap size={12} />\n+                            Wake\n+                        </button>\n+                    )}\n+\n+                    <div className={`${styles.status} ${styles[agent.status]}`}>\n+                        <Circle size={8} fill=\"currentColor\" className={styles.statusDot} />\n+                        <span className={styles.statusText}>{getStatusLabel(agent.status)}</span>\n+                    </div>\n+                </div>\n+            </div>\n+\n+            {/* Terminal Content */}\n+            <div className={styles.content} ref={scrollRef}>\n+                {agent.logs.length === 0 ? (\n+                    <div className={styles.emptyState}>\n+                        {agent.avatar ? (\n+                            <div className={styles.emptyAvatarWrapper}>\n+                                <Image\n+                                    src={agent.avatar}\n+                                    alt={agent.name}\n+                                    width={48}\n+                                    height={48}\n+                                    className={styles.avatar}\n+                                    unoptimized\n+                                />\n+                            </div>\n+                        ) : (\n+                            <span className={styles.emptyIcon}>{agent.emoji}</span>\n+                        )}\n+                        <span className={styles.emptyText}>Awaiting transmissions...</span>\n+                    </div>\n+                ) : (\n+                    agent.logs.map((log) => (\n+                        <div\n+                            key={log.id}\n+                            className={`${styles.logLine} ${styles[log.level.toLowerCase()]}`}\n+                        >\n+                            <span className={styles.timestamp}>{formatTimestamp(log.timestamp)}</span>\n+                            <span className={styles.icon}>{getLogLevelIcon(log.level)}</span>\n+                            <span className={styles.message}>{parseAnsiText(log.text)}</span>\n+                        </div>\n+                    ))\n+                )}\n+\n+                {/* Pending command indicator */}\n+                {isPending && (\n+                    <div className={styles.pendingCommand}>\n+                        <div className={styles.pendingSpinner} />\n+                        <span>Command queued, waiting for agent...</span>\n+                    </div>\n+                )}\n+            </div>\n+\n+            {/* Input Section */}\n+            <div className={styles.inputSection}>\n+                <span className={styles.inputPrompt} style={{ color: agent.color }}>\n+                    {agent.avatar ? (\n+                        <Image\n+                            src={agent.avatar}\n+                            alt=\"\"\n+                            width={16}\n+                            height={16}\n+                            className={styles.inputAvatar}\n+                            unoptimized\n+                        />\n+                    ) : (\n+                        agent.emoji\n+                    )}\n+                    {' '}&gt;\n+                </span>\n+                <input\n+                    ref={inputRef}\n+                    type=\"text\"\n+                    className={styles.input}\n+                    placeholder={agent.status !== 'offline' ? `Send command to ${agent.name}...` : `${agent.name} offline — commands will queue...`}\n+                    value={inputValue}\n+                    onChange={(e) => setInputValue(e.target.value)}\n+                    onKeyDown={handleKeyDown}\n+                    disabled={!onSendCommand}\n+                />\n+                <button\n+                    className={styles.sendButton}\n+                    onClick={handleSubmit}\n+                    disabled={!inputValue.trim() || !onSendCommand}\n+                    title=\"Send command (Enter)\"\n+                >\n+                    <Send size={14} />\n+                </button>\n+            </div>\n+\n+            {/* Color accent bar at bottom */}\n+            <div className={styles.accentBar} style={{ background: agent.color }} />\n+        </div>\n+    );\n+}\n+\n+export default AgentTerminal;\ndiff --git a/src/components/ActivityFeed/PermissionQueue.module.css b/src/components/ActivityFeed/PermissionQueue.module.css\nnew file mode 100644\nindex 0000000..bbcaecb\n--- /dev/null\n+++ b/src/components/ActivityFeed/PermissionQueue.module.css\n@@ -0,0 +1,395 @@\n+.container {\n+    display: flex;\n+    flex-direction: column;\n+    background: rgba(17, 17, 22, 0.9);\n+    backdrop-filter: blur(12px);\n+    border: 1px solid rgba(255, 255, 255, 0.08);\n+    border-radius: 14px;\n+    overflow: hidden;\n+    height: 100%;\n+}\n+\n+/* Header */\n+.header {\n+    display: flex;\n+    align-items: center;\n+    justify-content: space-between;\n+    padding: 8px 12px;\n+    background: rgba(24, 24, 27, 0.95);\n+    border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n+}\n+\n+.headerLeft {\n+    display: flex;\n+    align-items: center;\n+    gap: 10px;\n+}\n+\n+.headerIcon {\n+    color: rgba(255, 255, 255, 0.5);\n+}\n+\n+.title {\n+    font-size: 12px;\n+    font-weight: 700;\n+    text-transform: uppercase;\n+    letter-spacing: 0.1em;\n+    color: rgba(255, 255, 255, 0.7);\n+}\n+\n+.badge {\n+    display: flex;\n+    align-items: center;\n+    justify-content: center;\n+    min-width: 20px;\n+    height: 20px;\n+    padding: 0 6px;\n+    background: #ef4444;\n+    color: white;\n+    font-size: 11px;\n+    font-weight: 700;\n+    font-family: 'JetBrains Mono', monospace;\n+    border-radius: 10px;\n+    animation: pulse 2s ease-in-out infinite;\n+}\n+\n+/* Auto-approve Toggle */\n+.autoApproveToggle {\n+    display: flex;\n+    align-items: center;\n+    gap: 8px;\n+    cursor: pointer;\n+}\n+\n+.checkbox {\n+    width: 14px;\n+    height: 14px;\n+    accent-color: #06b6d4;\n+    cursor: pointer;\n+}\n+\n+.toggleLabel {\n+    font-size: 10px;\n+    color: rgba(255, 255, 255, 0.5);\n+    user-select: none;\n+}\n+\n+/* Content */\n+.content {\n+    flex: 1;\n+    padding: 12px;\n+    overflow-y: auto;\n+    display: flex;\n+    flex-direction: column;\n+    gap: 10px;\n+}\n+\n+/* Empty State */\n+.emptyState {\n+    flex: 1;\n+    display: flex;\n+    flex-direction: column;\n+    align-items: center;\n+    justify-content: center;\n+    gap: 10px;\n+    padding: 40px 20px;\n+}\n+\n+.emptyIcon {\n+    color: rgba(255, 255, 255, 0.15);\n+}\n+\n+.emptyText {\n+    font-size: 13px;\n+    font-weight: 600;\n+    color: rgba(255, 255, 255, 0.4);\n+}\n+\n+.emptySubtext {\n+    font-size: 11px;\n+    color: rgba(255, 255, 255, 0.25);\n+}\n+\n+/* Approve All Button */\n+.approveAllBtn {\n+    display: flex;\n+    align-items: center;\n+    justify-content: center;\n+    gap: 8px;\n+    padding: 10px 16px;\n+    background: rgba(16, 185, 129, 0.12);\n+    border: 1px solid rgba(16, 185, 129, 0.3);\n+    border-radius: 8px;\n+    color: #10b981;\n+    font-size: 12px;\n+    font-weight: 600;\n+    cursor: pointer;\n+    transition: all 0.15s ease;\n+}\n+\n+.approveAllBtn:hover {\n+    background: rgba(16, 185, 129, 0.2);\n+    border-color: rgba(16, 185, 129, 0.5);\n+}\n+\n+/* Cards Container */\n+.cards {\n+    display: flex;\n+    flex-direction: column;\n+    gap: 8px;\n+}\n+\n+/* Permission Card */\n+.card {\n+    background: rgba(255, 255, 255, 0.03);\n+    border: 1px solid rgba(255, 255, 255, 0.06);\n+    border-radius: 10px;\n+    padding: 12px;\n+    transition: all 0.2s ease;\n+}\n+\n+.card:hover {\n+    border-color: rgba(255, 255, 255, 0.1);\n+    background: rgba(255, 255, 255, 0.05);\n+}\n+\n+.cardNew {\n+    border-color: rgba(168, 85, 247, 0.4);\n+    animation: cardPulse 1.5s ease-in-out;\n+}\n+\n+.cardHeader {\n+    display: flex;\n+    align-items: center;\n+    justify-content: space-between;\n+    margin-bottom: 8px;\n+}\n+\n+.agentInfo {\n+    display: flex;\n+    align-items: center;\n+    gap: 8px;\n+}\n+\n+.agentEmoji {\n+    font-size: 16px;\n+}\n+\n+.agentName {\n+    font-size: 12px;\n+    font-weight: 600;\n+    color: rgba(255, 255, 255, 0.8);\n+}\n+\n+.timestamp {\n+    font-size: 10px;\n+    font-family: 'JetBrains Mono', monospace;\n+    color: rgba(255, 255, 255, 0.35);\n+}\n+\n+/* Tool Info */\n+.toolInfo {\n+    display: flex;\n+    align-items: center;\n+    gap: 8px;\n+    margin-bottom: 8px;\n+}\n+\n+.toolName {\n+    font-size: 13px;\n+    font-weight: 700;\n+    font-family: 'JetBrains Mono', monospace;\n+    color: #06b6d4;\n+}\n+\n+.trustedBadge {\n+    font-size: 9px;\n+    font-weight: 700;\n+    padding: 2px 6px;\n+    background: rgba(16, 185, 129, 0.15);\n+    border: 1px solid rgba(16, 185, 129, 0.3);\n+    color: #10b981;\n+    border-radius: 4px;\n+    text-transform: uppercase;\n+    letter-spacing: 0.05em;\n+}\n+\n+/* Params Preview */\n+.paramsPreview {\n+    position: relative;\n+    padding: 8px 10px;\n+    background: rgba(0, 0, 0, 0.3);\n+    border-radius: 6px;\n+    margin-bottom: 10px;\n+    cursor: pointer;\n+    overflow: hidden;\n+}\n+\n+.paramsPreview:hover {\n+    background: rgba(0, 0, 0, 0.4);\n+}\n+\n+.paramsCode {\n+    font-size: 10px;\n+    font-family: 'JetBrains Mono', monospace;\n+    color: rgba(255, 255, 255, 0.5);\n+    word-break: break-all;\n+    white-space: pre-wrap;\n+}\n+\n+.expandIcon {\n+    position: absolute;\n+    right: 8px;\n+    top: 50%;\n+    transform: translateY(-50%);\n+    color: rgba(255, 255, 255, 0.3);\n+}\n+\n+/* Action Buttons */\n+.actions {\n+    display: flex;\n+    gap: 8px;\n+}\n+\n+.actionBtn {\n+    flex: 1;\n+    display: flex;\n+    align-items: center;\n+    justify-content: center;\n+    gap: 6px;\n+    padding: 8px 12px;\n+    border-radius: 6px;\n+    font-size: 11px;\n+    font-weight: 600;\n+    cursor: pointer;\n+    transition: all 0.15s ease;\n+}\n+\n+.approveBtn {\n+    background: rgba(16, 185, 129, 0.12);\n+    border: 1px solid rgba(16, 185, 129, 0.3);\n+    color: #10b981;\n+}\n+\n+.approveBtn:hover {\n+    background: rgba(16, 185, 129, 0.25);\n+    border-color: rgba(16, 185, 129, 0.5);\n+}\n+\n+.rejectBtn {\n+    background: rgba(239, 68, 68, 0.12);\n+    border: 1px solid rgba(239, 68, 68, 0.3);\n+    color: #ef4444;\n+}\n+\n+.rejectBtn:hover {\n+    background: rgba(239, 68, 68, 0.25);\n+    border-color: rgba(239, 68, 68, 0.5);\n+}\n+\n+/* Keyboard Shortcuts */\n+.shortcuts {\n+    display: flex;\n+    align-items: center;\n+    justify-content: center;\n+    gap: 8px;\n+    padding: 8px 12px;\n+    background: rgba(0, 0, 0, 0.3);\n+    font-size: 10px;\n+    color: rgba(255, 255, 255, 0.35);\n+}\n+\n+.shortcutKey {\n+    display: inline-flex;\n+    align-items: center;\n+    justify-content: center;\n+    min-width: 18px;\n+    height: 18px;\n+    padding: 0 4px;\n+    margin-right: 4px;\n+    background: rgba(255, 255, 255, 0.08);\n+    border: 1px solid rgba(255, 255, 255, 0.15);\n+    border-radius: 4px;\n+    font-family: 'JetBrains Mono', monospace;\n+    font-size: 10px;\n+    font-weight: 600;\n+    color: rgba(255, 255, 255, 0.5);\n+}\n+\n+/* Scrollbar */\n+.content::-webkit-scrollbar {\n+    width: 6px;\n+}\n+\n+.content::-webkit-scrollbar-track {\n+    background: transparent;\n+}\n+\n+.content::-webkit-scrollbar-thumb {\n+    background: rgba(255, 255, 255, 0.1);\n+    border-radius: 3px;\n+}\n+\n+.content::-webkit-scrollbar-thumb:hover {\n+    background: rgba(255, 255, 255, 0.2);\n+}\n+\n+/* Animations */\n+@keyframes pulse {\n+    0%, 100% {\n+        opacity: 1;\n+    }\n+    50% {\n+        opacity: 0.7;\n+    }\n+}\n+\n+@keyframes cardPulse {\n+    0% {\n+        box-shadow: 0 0 0 0 rgba(168, 85, 247, 0.4);\n+    }\n+    70% {\n+        box-shadow: 0 0 0 8px rgba(168, 85, 247, 0);\n+    }\n+    100% {\n+        box-shadow: 0 0 0 0 rgba(168, 85, 247, 0);\n+    }\n+}\n+\n+/* Theme Overrides */\n+:global([data-theme='light']) .container {\n+    background: rgba(255, 255, 255, 0.9);\n+    border-color: rgba(0, 0, 0, 0.08);\n+}\n+\n+:global([data-theme='light']) .header {\n+    background: rgba(241, 245, 249, 0.95);\n+    border-color: rgba(0, 0, 0, 0.06);\n+}\n+\n+:global([data-theme='light']) .card {\n+    background: rgba(0, 0, 0, 0.02);\n+    border-color: rgba(0, 0, 0, 0.06);\n+}\n+\n+:global([data-theme='light']) .card:hover {\n+    background: rgba(0, 0, 0, 0.04);\n+    border-color: rgba(0, 0, 0, 0.1);\n+}\n+\n+:global([data-theme='light']) .agentName {\n+    color: rgba(0, 0, 0, 0.8);\n+}\n+\n+:global([data-theme='light']) .paramsPreview {\n+    background: rgba(0, 0, 0, 0.05);\n+}\n+\n+:global([data-theme='light']) .paramsCode {\n+    color: rgba(0, 0, 0, 0.6);\n+}\n+\n+:global([data-theme='light']) .shortcuts {\n+    background: rgba(0, 0, 0, 0.05);\n+    color: rgba(0, 0, 0, 0.4);\n+}\ndiff --git a/src/components/ActivityFeed/PermissionQueue.tsx b/src/components/ActivityFeed/PermissionQueue.tsx\nnew file mode 100644\nindex 0000000..4e0dcb9\n--- /dev/null\n+++ b/src/components/ActivityFeed/PermissionQueue.tsx\n@@ -0,0 +1,193 @@\n+'use client';\n+\n+import React, { useState, useEffect } from 'react';\n+import { Check, X, CheckCheck, Shield, ChevronDown, ChevronUp } from 'lucide-react';\n+import styles from './PermissionQueue.module.css';\n+import type { PermissionRequest } from '@/hooks/useActivityFeed';\n+\n+interface PermissionQueueProps {\n+    permissions: PermissionRequest[];\n+    onApprove: (id: string) => void;\n+    onReject: (id: string) => void;\n+    onApproveAll: () => void;\n+}\n+\n+// Trusted tools that can be auto-approved\n+const TRUSTED_TOOLS = [\n+    'Read',\n+    'Glob',\n+    'Grep',\n+    'WebSearch',\n+    'WebFetch',\n+];\n+\n+function formatTimeAgo(isoString: string): string {\n+    const diff = Date.now() - new Date(isoString).getTime();\n+    const seconds = Math.floor(diff / 1000);\n+\n+    if (seconds < 5) return 'just now';\n+    if (seconds < 60) return `${seconds}s`;\n+\n+    const minutes = Math.floor(seconds / 60);\n+    if (minutes < 60) return `${minutes}m`;\n+\n+    const hours = Math.floor(minutes / 60);\n+    return `${hours}h`;\n+}\n+\n+function truncateParams(params: Record<string, unknown>, maxLength = 100): string {\n+    const str = JSON.stringify(params, null, 0);\n+    if (str.length <= maxLength) return str;\n+    return str.slice(0, maxLength) + '...';\n+}\n+\n+export function PermissionQueue({\n+    permissions,\n+    onApprove,\n+    onReject,\n+    onApproveAll,\n+}: PermissionQueueProps) {\n+    const [autoApprove, setAutoApprove] = useState<boolean>(false);\n+    const [expandedId, setExpandedId] = useState<string | null>(null);\n+\n+    // Auto-approve trusted tools\n+    useEffect(() => {\n+        if (!autoApprove) return;\n+\n+        permissions.forEach((perm) => {\n+            if (TRUSTED_TOOLS.includes(perm.toolName)) {\n+                onApprove(perm.id);\n+            }\n+        });\n+    }, [permissions, autoApprove, onApprove]);\n+\n+    const toggleExpand = (id: string) => {\n+        setExpandedId(expandedId === id ? null : id);\n+    };\n+\n+    return (\n+        <div className={styles.container}>\n+            {/* Header */}\n+            <div className={styles.header}>\n+                <div className={styles.headerLeft}>\n+                    <Shield size={16} className={styles.headerIcon} />\n+                    <span className={styles.title}>Permission Queue</span>\n+                    {permissions.length > 0 && (\n+                        <span className={styles.badge}>{permissions.length}</span>\n+                    )}\n+                </div>\n+\n+                {/* Auto-approve Toggle */}\n+                <label className={styles.autoApproveToggle}>\n+                    <input\n+                        type=\"checkbox\"\n+                        checked={autoApprove}\n+                        onChange={(e) => setAutoApprove(e.target.checked)}\n+                        className={styles.checkbox}\n+                    />\n+                    <span className={styles.toggleLabel}>Auto-approve trusted</span>\n+                </label>\n+            </div>\n+\n+            {/* Queue Content */}\n+            <div className={styles.content}>\n+                {permissions.length === 0 ? (\n+                    <div className={styles.emptyState}>\n+                        <Shield size={32} className={styles.emptyIcon} />\n+                        <span className={styles.emptyText}>No pending permissions</span>\n+                        <span className={styles.emptySubtext}>All clear</span>\n+                    </div>\n+                ) : (\n+                    <>\n+                        {/* Approve All Button */}\n+                        <button\n+                            className={styles.approveAllBtn}\n+                            onClick={onApproveAll}\n+                            title=\"Approve all pending permissions\"\n+                        >\n+                            <CheckCheck size={14} />\n+                            <span>Approve All ({permissions.length})</span>\n+                        </button>\n+\n+                        {/* Permission Cards */}\n+                        <div className={styles.cards}>\n+                            {permissions.map((perm) => (\n+                                <div\n+                                    key={perm.id}\n+                                    className={`${styles.card} ${perm.isNew ? styles.cardNew : ''}`}\n+                                >\n+                                    {/* Card Header */}\n+                                    <div className={styles.cardHeader}>\n+                                        <div className={styles.agentInfo}>\n+                                            <span className={styles.agentEmoji}>{perm.agentEmoji}</span>\n+                                            <span className={styles.agentName}>{perm.agentName}</span>\n+                                        </div>\n+                                        <span className={styles.timestamp}>{formatTimeAgo(perm.timestamp)}</span>\n+                                    </div>\n+\n+                                    {/* Tool Info */}\n+                                    <div className={styles.toolInfo}>\n+                                        <span className={styles.toolName}>{perm.toolName}</span>\n+                                        {TRUSTED_TOOLS.includes(perm.toolName) && (\n+                                            <span className={styles.trustedBadge}>Trusted</span>\n+                                        )}\n+                                    </div>\n+\n+                                    {/* Params Preview */}\n+                                    <div\n+                                        className={styles.paramsPreview}\n+                                        onClick={() => toggleExpand(perm.id)}\n+                                    >\n+                                        <code className={styles.paramsCode}>\n+                                            {expandedId === perm.id\n+                                                ? JSON.stringify(perm.params, null, 2)\n+                                                : truncateParams(perm.params)}\n+                                        </code>\n+                                        {Object.keys(perm.params).length > 0 && (\n+                                            <span className={styles.expandIcon}>\n+                                                {expandedId === perm.id ? (\n+                                                    <ChevronUp size={14} />\n+                                                ) : (\n+                                                    <ChevronDown size={14} />\n+                                                )}\n+                                            </span>\n+                                        )}\n+                                    </div>\n+\n+                                    {/* Action Buttons */}\n+                                    <div className={styles.actions}>\n+                                        <button\n+                                            className={`${styles.actionBtn} ${styles.approveBtn}`}\n+                                            onClick={() => onApprove(perm.id)}\n+                                            title=\"Approve (Press 1)\"\n+                                        >\n+                                            <Check size={14} />\n+                                            <span>Approve</span>\n+                                        </button>\n+                                        <button\n+                                            className={`${styles.actionBtn} ${styles.rejectBtn}`}\n+                                            onClick={() => onReject(perm.id)}\n+                                            title=\"Reject (Press 2)\"\n+                                        >\n+                                            <X size={14} />\n+                                            <span>Reject</span>\n+                                        </button>\n+                                    </div>\n+                                </div>\n+                            ))}\n+                        </div>\n+                    </>\n+                )}\n+            </div>\n+\n+            {/* Keyboard Shortcuts Hint */}\n+            <div className={styles.shortcuts}>\n+                <span className={styles.shortcutKey}>1</span> Approve\n+                <span className={styles.shortcutKey}>2</span> Reject\n+                <span className={styles.shortcutKey}>A</span> All\n+            </div>\n+        </div>\n+    );\n+}\n+\n+export default PermissionQueue;\ndiff --git a/src/components/ActivityFeed/TicketStrip.module.css b/src/components/ActivityFeed/TicketStrip.module.css\nnew file mode 100644\nindex 0000000..62ec3ae\n--- /dev/null\n+++ b/src/components/ActivityFeed/TicketStrip.module.css\n@@ -0,0 +1,522 @@\n+/* ═══════════════════════════════════════════════════════════════════════════\n+   TicketStrip - Jira ticket display for Halo agents\n+   Cyber-Industrial dark aesthetic with glassmorphism\n+   ═══════════════════════════════════════════════════════════════════════════ */\n+\n+.container {\n+    width: 100%;\n+    padding: 0;\n+}\n+\n+.strip {\n+    display: grid;\n+    grid-template-columns: repeat(6, 1fr);\n+    gap: 6px;\n+    background: rgba(9, 9, 11, 0.85);\n+    backdrop-filter: blur(12px);\n+    border: 1px solid rgba(255, 255, 255, 0.06);\n+    border-radius: 8px;\n+    padding: 6px;\n+    box-shadow:\n+        0 4px 24px rgba(0, 0, 0, 0.3),\n+        inset 0 1px 0 rgba(255, 255, 255, 0.04);\n+}\n+\n+/* ─── Agent Column ─────────────────────────────────────────────────────────── */\n+\n+.agentColumn {\n+    display: flex;\n+    flex-direction: column;\n+    gap: 3px;\n+    padding: 5px;\n+    background: rgba(17, 17, 22, 0.6);\n+    border: 1px solid rgba(255, 255, 255, 0.04);\n+    border-radius: 6px;\n+    transition: all 0.2s ease;\n+}\n+\n+.agentColumn:hover {\n+    border-color: var(--agent-color, rgba(255, 255, 255, 0.1));\n+    box-shadow: 0 0 16px rgba(0, 0, 0, 0.2), 0 0 0 1px var(--agent-color);\n+}\n+\n+/* ─── Agent Header ─────────────────────────────────────────────────────────── */\n+\n+.agentHeader {\n+    display: flex;\n+    align-items: center;\n+    gap: 5px;\n+    padding-bottom: 3px;\n+    border-bottom: 1px solid rgba(255, 255, 255, 0.04);\n+}\n+\n+.avatarWrapper {\n+    width: 24px;\n+    height: 24px;\n+    border-radius: 50%;\n+    border: 2px solid var(--agent-color, #06b6d4);\n+    overflow: hidden;\n+    flex-shrink: 0;\n+    box-shadow: 0 0 8px rgba(0, 0, 0, 0.3), 0 0 6px var(--agent-color);\n+}\n+\n+.avatar {\n+    width: 100%;\n+    height: 100%;\n+    object-fit: cover;\n+    border-radius: 50%;\n+}\n+\n+.agentName {\n+    font-size: 12px;\n+    font-weight: 600;\n+    letter-spacing: 0.06em;\n+    color: var(--agent-color, rgba(255, 255, 255, 0.8));\n+    text-transform: uppercase;\n+}\n+\n+/* ─── Ticket Rows ──────────────────────────────────────────────────────────── */\n+\n+.ticketRows {\n+    display: flex;\n+    flex-direction: column;\n+    gap: 4px;\n+}\n+\n+/* ─── Ticket Slot Base ─────────────────────────────────────────────────────── */\n+\n+.ticketSlot {\n+    position: relative;\n+    padding: 3px 6px;\n+    border-radius: 4px;\n+    background: rgba(9, 9, 11, 0.6);\n+    border: 1px solid rgba(255, 255, 255, 0.04);\n+    min-height: 20px;\n+    transition: all 0.2s ease;\n+}\n+\n+.ticketSlot:hover {\n+    background: rgba(9, 9, 11, 0.8);\n+}\n+\n+/* ─── Done Slot ────────────────────────────────────────────────────────────── */\n+\n+.ticketSlot.done {\n+    background: rgba(16, 185, 129, 0.06);\n+    border-color: rgba(16, 185, 129, 0.15);\n+    opacity: 0.75;\n+}\n+\n+.ticketSlot.done .ticketKey {\n+    color: #10b981;\n+}\n+\n+.ticketSlot.done .ticketSummary {\n+    color: rgba(255, 255, 255, 0.5);\n+    text-decoration: line-through;\n+    text-decoration-color: rgba(16, 185, 129, 0.4);\n+}\n+\n+.ticketSlot.done .statusIndicator {\n+    color: #10b981;\n+}\n+\n+/* ─── In Progress Slot ─────────────────────────────────────────────────────── */\n+\n+.ticketSlot.inProgress {\n+    background: rgba(6, 182, 212, 0.08);\n+    border-color: rgba(6, 182, 212, 0.25);\n+    box-shadow:\n+        0 0 12px rgba(6, 182, 212, 0.1),\n+        inset 0 0 0 1px rgba(6, 182, 212, 0.1);\n+}\n+\n+.ticketSlot.inProgress .ticketKey {\n+    color: #06b6d4;\n+    font-weight: 700;\n+}\n+\n+.ticketSlot.inProgress .ticketSummary {\n+    color: rgba(255, 255, 255, 0.85);\n+}\n+\n+.ticketSlot.inProgress .statusIndicator {\n+    color: #06b6d4;\n+}\n+\n+/* ─── Next Slot ────────────────────────────────────────────────────────────── */\n+\n+.ticketSlot.next {\n+    background: rgba(168, 85, 247, 0.06);\n+    border: 1px dashed rgba(168, 85, 247, 0.3);\n+}\n+\n+.ticketSlot.next .ticketKey {\n+    color: #a855f7;\n+}\n+\n+.ticketSlot.next .ticketSummary {\n+    color: rgba(255, 255, 255, 0.6);\n+}\n+\n+.ticketSlot.next .statusIndicator {\n+    color: #a855f7;\n+}\n+\n+/* ─── Empty State ──────────────────────────────────────────────────────────── */\n+\n+.ticketSlot.empty {\n+    display: flex;\n+    align-items: center;\n+    justify-content: center;\n+    background: rgba(9, 9, 11, 0.4);\n+    border-color: transparent;\n+}\n+\n+.emptyText {\n+    font-size: 11px;\n+    color: rgba(255, 255, 255, 0.2);\n+    font-style: italic;\n+    letter-spacing: 0.04em;\n+}\n+\n+/* ─── Ticket Content ───────────────────────────────────────────────────────── */\n+\n+.ticketHeader {\n+    display: flex;\n+    justify-content: space-between;\n+    align-items: center;\n+    gap: 4px;\n+    margin-bottom: 2px;\n+}\n+\n+.ticketKey {\n+    font-size: 10px;\n+    font-weight: 600;\n+    font-family: 'JetBrains Mono', 'Fira Code', monospace;\n+    letter-spacing: 0.02em;\n+}\n+\n+.ticketTime {\n+    font-size: 9px;\n+    color: rgba(255, 255, 255, 0.3);\n+    font-family: 'JetBrains Mono', 'Fira Code', monospace;\n+}\n+\n+.ticketSummary {\n+    font-size: 10px;\n+    line-height: 1.3;\n+    color: rgba(255, 255, 255, 0.7);\n+    overflow: hidden;\n+    text-overflow: ellipsis;\n+    white-space: nowrap;\n+    padding-right: 12px;\n+}\n+\n+/* ─── Status Indicators ────────────────────────────────────────────────────── */\n+\n+.statusIndicator {\n+    position: absolute;\n+    top: 6px;\n+    right: 6px;\n+    width: 12px;\n+    height: 12px;\n+    display: flex;\n+    align-items: center;\n+    justify-content: center;\n+}\n+\n+.checkIcon {\n+    width: 12px;\n+    height: 12px;\n+}\n+\n+.nextIcon {\n+    width: 12px;\n+    height: 12px;\n+}\n+\n+.pulsingDot {\n+    width: 6px;\n+    height: 6px;\n+    background: #06b6d4;\n+    border-radius: 50%;\n+    animation: pulse 1.5s ease-in-out infinite;\n+    box-shadow: 0 0 6px #06b6d4;\n+}\n+\n+@keyframes pulse {\n+    0%, 100% {\n+        opacity: 1;\n+        transform: scale(1);\n+    }\n+    50% {\n+        opacity: 0.5;\n+        transform: scale(1.2);\n+    }\n+}\n+\n+/* ─── Loading Skeleton ─────────────────────────────────────────────────────── */\n+\n+.skeleton {\n+    background: linear-gradient(\n+        90deg,\n+        rgba(255, 255, 255, 0.04) 0%,\n+        rgba(255, 255, 255, 0.08) 50%,\n+        rgba(255, 255, 255, 0.04) 100%\n+    );\n+    background-size: 200% 100%;\n+    animation: shimmer 1.5s infinite;\n+    border-radius: 4px;\n+}\n+\n+.skeleton.avatarWrapper {\n+    border-color: rgba(255, 255, 255, 0.1);\n+    box-shadow: none;\n+}\n+\n+.skeleton.agentName {\n+    width: 50px;\n+    height: 12px;\n+}\n+\n+.skeleton.ticketSlot {\n+    border: none;\n+}\n+\n+@keyframes shimmer {\n+    0% {\n+        background-position: 200% 0;\n+    }\n+    100% {\n+        background-position: -200% 0;\n+    }\n+}\n+\n+/* ─── Light Theme ──────────────────────────────────────────────────────────── */\n+\n+:global([data-theme='light']) .strip {\n+    background: rgba(255, 255, 255, 0.85);\n+    border-color: rgba(0, 0, 0, 0.08);\n+    box-shadow:\n+        0 4px 24px rgba(0, 0, 0, 0.08),\n+        inset 0 1px 0 rgba(255, 255, 255, 0.5);\n+}\n+\n+:global([data-theme='light']) .agentColumn {\n+    background: rgba(241, 245, 249, 0.8);\n+    border-color: rgba(0, 0, 0, 0.06);\n+}\n+\n+:global([data-theme='light']) .agentHeader {\n+    border-bottom-color: rgba(0, 0, 0, 0.06);\n+}\n+\n+:global([data-theme='light']) .ticketSlot {\n+    background: rgba(248, 250, 252, 0.9);\n+    border-color: rgba(0, 0, 0, 0.06);\n+}\n+\n+:global([data-theme='light']) .ticketSlot.done {\n+    background: rgba(16, 185, 129, 0.08);\n+    border-color: rgba(16, 185, 129, 0.2);\n+}\n+\n+:global([data-theme='light']) .ticketSlot.done .ticketSummary {\n+    color: rgba(0, 0, 0, 0.5);\n+}\n+\n+:global([data-theme='light']) .ticketSlot.inProgress {\n+    background: rgba(6, 182, 212, 0.1);\n+    border-color: rgba(6, 182, 212, 0.3);\n+}\n+\n+:global([data-theme='light']) .ticketSlot.inProgress .ticketSummary {\n+    color: rgba(0, 0, 0, 0.8);\n+}\n+\n+:global([data-theme='light']) .ticketSlot.next {\n+    background: rgba(168, 85, 247, 0.08);\n+    border-color: rgba(168, 85, 247, 0.25);\n+}\n+\n+:global([data-theme='light']) .ticketSlot.next .ticketSummary {\n+    color: rgba(0, 0, 0, 0.6);\n+}\n+\n+:global([data-theme='light']) .ticketSlot.empty {\n+    background: rgba(241, 245, 249, 0.6);\n+}\n+\n+:global([data-theme='light']) .emptyText {\n+    color: rgba(0, 0, 0, 0.25);\n+}\n+\n+:global([data-theme='light']) .ticketSummary {\n+    color: rgba(0, 0, 0, 0.7);\n+}\n+\n+:global([data-theme='light']) .ticketTime {\n+    color: rgba(0, 0, 0, 0.4);\n+}\n+\n+/* ─── Responsive ───────────────────────────────────────────────────────────── */\n+\n+@media (max-width: 1200px) {\n+    .strip {\n+        grid-template-columns: repeat(3, 1fr);\n+    }\n+}\n+\n+@media (max-width: 768px) {\n+    .strip {\n+        grid-template-columns: repeat(2, 1fr);\n+    }\n+}\n+\n+@media (max-width: 480px) {\n+    .strip {\n+        grid-template-columns: 1fr;\n+    }\n+}\n+\n+/* ═══════════════════════════════════════════════════════════════════════════\n+   Header & Refresh Section - Jira ticket controls\n+   ═══════════════════════════════════════════════════════════════════════════ */\n+\n+.refreshSection {\n+    display: flex;\n+    flex-direction: row;\n+    align-items: center;\n+    justify-content: flex-end;\n+    gap: 6px;\n+    padding-bottom: 2px;\n+}\n+\n+.lastUpdated {\n+    font-size: 0.75rem;\n+    color: rgba(255, 255, 255, 0.35);\n+    font-family: 'JetBrains Mono', 'Consolas', monospace;\n+}\n+\n+.refreshButton {\n+    display: flex;\n+    align-items: center;\n+    justify-content: center;\n+    padding: 0.25rem;\n+    background: transparent;\n+    border: 1px solid rgba(255, 255, 255, 0.1);\n+    border-radius: 4px;\n+    color: rgba(255, 255, 255, 0.5);\n+    cursor: pointer;\n+    transition: all 0.2s ease;\n+}\n+\n+.refreshButton:hover {\n+    background: rgba(255, 255, 255, 0.05);\n+    border-color: rgba(255, 255, 255, 0.15);\n+    color: rgba(255, 255, 255, 0.7);\n+}\n+\n+.spinning {\n+    animation: spin 1s linear infinite;\n+}\n+\n+@keyframes spin {\n+    from {\n+        transform: rotate(0deg);\n+    }\n+    to {\n+        transform: rotate(360deg);\n+    }\n+}\n+\n+/* ─── Ticket Action Buttons ───────────────────────────────────────────────── */\n+\n+.pickUpButton {\n+    display: flex;\n+    align-items: center;\n+    justify-content: center;\n+    gap: 3px;\n+    width: 100%;\n+    margin-top: 3px;\n+    padding: 2px 6px;\n+    font-size: 10px;\n+    font-weight: 600;\n+    color: hsl(188 95% 43%);\n+    background: transparent;\n+    border: 1px solid hsl(188 95% 43%);\n+    border-radius: 4px;\n+    cursor: pointer;\n+    transition: all 0.2s ease;\n+}\n+\n+.pickUpButton:hover:not(:disabled) {\n+    background: hsla(188, 95%, 43%, 0.1);\n+    box-shadow: 0 0 8px hsla(188, 95%, 43%, 0.3);\n+}\n+\n+.pickUpButton:disabled {\n+    opacity: 0.5;\n+    cursor: not-allowed;\n+}\n+\n+.completeButton {\n+    display: flex;\n+    align-items: center;\n+    justify-content: center;\n+    gap: 3px;\n+    width: 100%;\n+    margin-top: 3px;\n+    padding: 2px 6px;\n+    font-size: 10px;\n+    font-weight: 600;\n+    color: hsl(142 76% 36%);\n+    background: transparent;\n+    border: 1px solid hsl(142 76% 36%);\n+    border-radius: 4px;\n+    cursor: pointer;\n+    transition: all 0.2s ease;\n+}\n+\n+.completeButton:hover:not(:disabled) {\n+    background: hsla(142, 76%, 36%, 0.1);\n+    box-shadow: 0 0 8px hsla(142, 76%, 36%, 0.3);\n+}\n+\n+.completeButton:disabled {\n+    opacity: 0.5;\n+    cursor: not-allowed;\n+}\n+\n+.buttonLoading {\n+    display: flex;\n+    align-items: center;\n+    justify-content: center;\n+    opacity: 0.7;\n+}\n+\n+/* ─── Light Theme Overrides ───────────────────────────────────────────────── */\n+\n+:global([data-theme='light']) .header {\n+    border-bottom-color: rgba(0, 0, 0, 0.08);\n+}\n+\n+:global([data-theme='light']) .title {\n+    color: rgba(0, 0, 0, 0.85);\n+}\n+\n+:global([data-theme='light']) .lastUpdated {\n+    color: rgba(0, 0, 0, 0.4);\n+}\n+\n+:global([data-theme='light']) .refreshButton {\n+    border-color: rgba(0, 0, 0, 0.12);\n+    color: rgba(0, 0, 0, 0.5);\n+}\n+\n+:global([data-theme='light']) .refreshButton:hover {\n+    background: rgba(0, 0, 0, 0.04);\n+    border-color: rgba(0, 0, 0, 0.18);\n+    color: rgba(0, 0, 0, 0.7);\n+}\ndiff --git a/src/components/ActivityFeed/TicketStrip.tsx b/src/components/ActivityFeed/TicketStrip.tsx\nnew file mode 100644\nindex 0000000..3f38460\n--- /dev/null\n+++ b/src/components/ActivityFeed/TicketStrip.tsx\n@@ -0,0 +1,287 @@\n+'use client';\n+\n+import React, { useState } from 'react';\n+import Image from 'next/image';\n+import { ArrowRight, Check, RefreshCw, Loader2 } from 'lucide-react';\n+import styles from './TicketStrip.module.css';\n+\n+// ─── Types ────────────────────────────────────────────────────────────────────\n+\n+export interface Ticket {\n+    key: string;\n+    summary: string;\n+    status: string;\n+    priority: string;\n+    updated: string;\n+}\n+\n+export interface AgentTickets {\n+    done: Ticket | null;\n+    inProgress: Ticket | null;\n+    next: Ticket | null;\n+}\n+\n+export interface TicketStripProps {\n+    tickets: {\n+        [agentId: string]: AgentTickets;\n+    };\n+    isLoading?: boolean;\n+    onTransition?: (key: string, status: 'In Progress' | 'Done', comment?: string) => Promise<void>;\n+    onRefresh?: () => void;\n+    lastUpdated?: string | null;\n+}\n+\n+// ─── Agent Configuration ──────────────────────────────────────────────────────\n+\n+const AGENTS = [\n+    { id: 'chief', name: 'Chief', color: '#f59e0b' },\n+    { id: 'hunter', name: 'Hunter', color: '#10b981' },\n+    { id: 'ops', name: 'Ops', color: '#06b6d4' },\n+    { id: 'scout', name: 'Scout', color: '#8b5cf6' },\n+    { id: 'arbiter', name: 'Arbiter', color: '#ef4444' },\n+    { id: 'cortana', name: 'Cortana', color: '#ec4899' },\n+] as const;\n+\n+// ─── Utility Functions ────────────────────────────────────────────────────────\n+\n+function formatTimeAgo(dateString: string): string {\n+    const now = new Date();\n+    const date = new Date(dateString);\n+    const diffMs = now.getTime() - date.getTime();\n+    const diffMins = Math.floor(diffMs / 60000);\n+    const diffHours = Math.floor(diffMins / 60);\n+    const diffDays = Math.floor(diffHours / 24);\n+\n+    if (diffMins < 1) return 'just now';\n+    if (diffMins < 60) return `${diffMins}m ago`;\n+    if (diffHours < 24) return `${diffHours}h ago`;\n+    if (diffDays < 7) return `${diffDays}d ago`;\n+    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });\n+}\n+\n+function truncateSummary(summary: string, maxLength: number = 40): string {\n+    if (summary.length <= maxLength) return summary;\n+    return summary.slice(0, maxLength - 3) + '...';\n+}\n+\n+// ─── Subcomponents ────────────────────────────────────────────────────────────\n+\n+interface TicketCardProps {\n+    ticket: Ticket | null;\n+    slotType: 'done' | 'inProgress' | 'next';\n+    onTransition?: (key: string, status: 'In Progress' | 'Done', comment?: string) => Promise<void>;\n+}\n+\n+function TicketCard({ ticket, slotType, onTransition }: TicketCardProps) {\n+    const [isTransitioning, setIsTransitioning] = useState(false);\n+\n+    const handlePickUp = async () => {\n+        if (!ticket || !onTransition || isTransitioning) return;\n+        setIsTransitioning(true);\n+        try {\n+            await onTransition(ticket.key, 'In Progress', 'Picked up via Activity Feed');\n+        } finally {\n+            setIsTransitioning(false);\n+        }\n+    };\n+\n+    const handleComplete = async () => {\n+        if (!ticket || !onTransition || isTransitioning) return;\n+        setIsTransitioning(true);\n+        try {\n+            await onTransition(ticket.key, 'Done', 'Completed via Activity Feed');\n+        } finally {\n+            setIsTransitioning(false);\n+        }\n+    };\n+\n+    if (!ticket) {\n+        return (\n+            <div className={`${styles.ticketSlot} ${styles[slotType]} ${styles.empty}`}>\n+                <span className={styles.emptyText}>No tickets</span>\n+            </div>\n+        );\n+    }\n+\n+    return (\n+        <div className={`${styles.ticketSlot} ${styles[slotType]}`}>\n+            <div className={styles.ticketHeader}>\n+                <span className={styles.ticketKey}>{ticket.key}</span>\n+                <span className={styles.ticketTime}>{formatTimeAgo(ticket.updated)}</span>\n+            </div>\n+            <div className={styles.ticketSummary}>\n+                {truncateSummary(ticket.summary)}\n+            </div>\n+            <div className={styles.statusIndicator}>\n+                {slotType === 'done' && (\n+                    <svg className={styles.checkIcon} viewBox=\"0 0 16 16\" fill=\"none\">\n+                        <path d=\"M13.5 4.5L6 12L2.5 8.5\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"/>\n+                    </svg>\n+                )}\n+                {slotType === 'inProgress' && (\n+                    <span className={styles.pulsingDot} />\n+                )}\n+                {slotType === 'next' && (\n+                    <svg className={styles.nextIcon} viewBox=\"0 0 16 16\" fill=\"none\">\n+                        <circle cx=\"8\" cy=\"8\" r=\"6\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeDasharray=\"3 2\"/>\n+                    </svg>\n+                )}\n+            </div>\n+            {slotType === 'next' && onTransition && (\n+                <button\n+                    className={`${styles.pickUpButton} ${isTransitioning ? styles.buttonLoading : ''}`}\n+                    onClick={handlePickUp}\n+                    disabled={isTransitioning}\n+                >\n+                    {isTransitioning ? (\n+                        <Loader2 size={12} className={styles.spinning} />\n+                    ) : (\n+                        <>\n+                            <ArrowRight size={12} />\n+                            Pick Up\n+                        </>\n+                    )}\n+                </button>\n+            )}\n+            {slotType === 'inProgress' && onTransition && (\n+                <button\n+                    className={`${styles.completeButton} ${isTransitioning ? styles.buttonLoading : ''}`}\n+                    onClick={handleComplete}\n+                    disabled={isTransitioning}\n+                >\n+                    {isTransitioning ? (\n+                        <Loader2 size={12} className={styles.spinning} />\n+                    ) : (\n+                        <>\n+                            <Check size={12} />\n+                            Complete\n+                        </>\n+                    )}\n+                </button>\n+            )}\n+        </div>\n+    );\n+}\n+\n+interface AgentColumnProps {\n+    agentId: string;\n+    agentName: string;\n+    agentColor: string;\n+    tickets: AgentTickets;\n+    onTransition?: (key: string, status: 'In Progress' | 'Done', comment?: string) => Promise<void>;\n+}\n+\n+function AgentColumn({ agentId, agentName, agentColor, tickets, onTransition }: AgentColumnProps) {\n+    return (\n+        <div\n+            className={styles.agentColumn}\n+            style={{ '--agent-color': agentColor } as React.CSSProperties}\n+        >\n+            <div className={styles.agentHeader}>\n+                <div className={styles.avatarWrapper}>\n+                    <Image\n+                        src={`/avatars/halo/${agentId}.png`}\n+                        alt={agentName}\n+                        width={24}\n+                        height={24}\n+                        className={styles.avatar}\n+                    />\n+                </div>\n+                <span className={styles.agentName}>{agentName}</span>\n+            </div>\n+            <div className={styles.ticketRows}>\n+                <TicketCard ticket={tickets.done} slotType=\"done\" onTransition={onTransition} />\n+                <TicketCard ticket={tickets.inProgress} slotType=\"inProgress\" onTransition={onTransition} />\n+                <TicketCard ticket={tickets.next} slotType=\"next\" onTransition={onTransition} />\n+            </div>\n+        </div>\n+    );\n+}\n+\n+// ─── Loading State ────────────────────────────────────────────────────────────\n+\n+function LoadingSkeleton() {\n+    return (\n+        <div className={styles.container}>\n+            <div className={styles.strip}>\n+                {AGENTS.map((agent) => (\n+                    <div\n+                        key={agent.id}\n+                        className={styles.agentColumn}\n+                        style={{ '--agent-color': agent.color } as React.CSSProperties}\n+                    >\n+                        <div className={styles.agentHeader}>\n+                            <div className={`${styles.avatarWrapper} ${styles.skeleton}`} />\n+                            <span className={`${styles.agentName} ${styles.skeleton}`}>&nbsp;</span>\n+                        </div>\n+                        <div className={styles.ticketRows}>\n+                            <div className={`${styles.ticketSlot} ${styles.skeleton}`} />\n+                            <div className={`${styles.ticketSlot} ${styles.skeleton}`} />\n+                            <div className={`${styles.ticketSlot} ${styles.skeleton}`} />\n+                        </div>\n+                    </div>\n+                ))}\n+            </div>\n+        </div>\n+    );\n+}\n+\n+// ─── Main Component ───────────────────────────────────────────────────────────\n+\n+export function TicketStrip({ tickets, isLoading = false, onTransition, onRefresh, lastUpdated }: TicketStripProps) {\n+    const [isRefreshing, setIsRefreshing] = useState(false);\n+\n+    const handleRefresh = async () => {\n+        if (!onRefresh || isRefreshing) return;\n+        setIsRefreshing(true);\n+        try {\n+            onRefresh();\n+        } finally {\n+            // Reset after a short delay to show the animation\n+            setTimeout(() => setIsRefreshing(false), 1000);\n+        }\n+    };\n+\n+    if (isLoading) {\n+        return <LoadingSkeleton />;\n+    }\n+\n+    const emptyTickets: AgentTickets = { done: null, inProgress: null, next: null };\n+\n+    return (\n+        <div className={styles.container}>\n+            {/* Refresh button inline — header removed to save space */}\n+            {onRefresh && (\n+                <div className={styles.refreshSection}>\n+                    {lastUpdated && (\n+                        <span className={styles.lastUpdated}>\n+                            Updated {formatTimeAgo(lastUpdated)}\n+                        </span>\n+                    )}\n+                    <button\n+                        className={`${styles.refreshButton} ${isRefreshing ? styles.spinning : ''}`}\n+                        onClick={handleRefresh}\n+                        disabled={isRefreshing}\n+                        title=\"Refresh tickets\"\n+                    >\n+                        <RefreshCw size={14} />\n+                    </button>\n+                </div>\n+            )}\n+            <div className={styles.strip}>\n+                {AGENTS.map((agent) => (\n+                    <AgentColumn\n+                        key={agent.id}\n+                        agentId={agent.id}\n+                        agentName={agent.name}\n+                        agentColor={agent.color}\n+                        tickets={tickets[agent.id] || emptyTickets}\n+                        onTransition={onTransition}\n+                    />\n+                ))}\n+            </div>\n+        </div>\n+    );\n+}\n+\n+export default TicketStrip;\ndiff --git a/src/components/ActivityFeed/index.ts b/src/components/ActivityFeed/index.ts\nnew file mode 100644\nindex 0000000..dc2c305\n--- /dev/null\n+++ b/src/components/ActivityFeed/index.ts\n@@ -0,0 +1,5 @@\n+export { ActivityStats } from './ActivityStats';\n+export { AgentTerminal } from './AgentTerminal';\n+export { PermissionQueue } from './PermissionQueue';\n+export { TicketStrip } from './TicketStrip';\n+export type { Ticket, AgentTickets, TicketStripProps } from './TicketStrip';\r","stderr":"","interrupted":false,"isImage":false},"tool_use_id":"toolu_01SvTgM6u3VhMoCH35jNXnuh"}

[2026-03-22T11:57:28Z] PRE-TOOL-USE: INPUT: {"session_id":"76e04d75-d5f6-450f-8a85-ef4870bcbcb1","transcript_path":"C:\\Users\\jackw\\.claude\\projects\\C--Users-jackw-Desktop-SwjshAlgoKnife\\76e04d75-d5f6-450f-8a85-ef4870bcbcb1.jsonl","cwd":"C:\\Users\\jackw\\Desktop\\SwjshAlgoKnife","permission_mode":"default","hook_event_name":"PreToolUse","tool_name":"Edit","tool_input":{"file_path":"C:\\Users\\jackw\\Desktop\\SwjshAlgoKnife\\src\\app\\api\\health\\route.ts","old_string":"import { NextResponse } from 'next/server';\nimport intelBus from '@/lib/intel/bus';\n\n/**\n * GET /api/health\n *\n * Returns health status for all background intel services.\n * Each service writes heartbeats to the settings table via intelBus.heartbeat().\n *\n * Status values:\n *   RUNNING     — Heartbeat within last 5 minutes\n *   STALE       — Heartbeat between 5–15 minutes ago\n *   DEAD        — Heartbeat older than 15 minutes\n *   NOT_STARTED — No heartbeat recorded\n *   ERROR       — Failed to read health data\n */\nexport async function GET() {\n    try {\n        const services = intelBus.getHealth();\n\n        // Overall status: healthy if at least one service is running\n        const runningCount = Object.values(services).filter(s => s.status === 'RUNNING').length;\n        const overall = runningCount > 0 ? 'HEALTHY' : 'DEGRADED';\n\n        return NextResponse.json({\n            status: overall,\n            timestamp: new Date().toISOString(),\n            services,\n        });\n    } catch (error: any) {\n        console.error('[API /health] Error:', error);\n        return NextResponse.json({\n            status: 'ERROR',\n            timestamp: new Date().toISOString(),\n            error: error.message,\n        }, { status: 500 });\n    }\n}","new_string":"import { NextResponse } from 'next/server';\nimport intelBus from '@/lib/intel/bus';\nimport { checkDbHealth, DbHealthStatus } from '@/lib/dbHealth';\n\n/**\n * GET /api/health\n *\n * Returns health status for all background intel services AND database.\n *\n * Intel Service Status values:\n *   RUNNING     — Heartbeat within last 5 minutes\n *   STALE       — Heartbeat between 5–15 minutes ago\n *   DEAD        — Heartbeat older than 15 minutes\n *   NOT_STARTED — No heartbeat recorded\n *   ERROR       — Failed to read health data\n *\n * Database Status values (PULSE-11):\n *   HEALTHY     — Connected, low latency, file accessible\n *   DEGRADED    — Connected but elevated latency or large file size\n *   UNHEALTHY   — Connected but high latency or permission issues\n *   ERROR       — Cannot connect or file missing\n */\nexport async function GET() {\n    try {\n        // Check Intel services health\n        const services = intelBus.getHealth();\n        const runningCount = Object.values(services).filter(s => s.status === 'RUNNING').length;\n        const servicesHealthy = runningCount > 0;\n\n        // Check Database health (PULSE-11)\n        let database: DbHealthStatus;\n        try {\n            database = checkDbHealth();\n        } catch (error: any) {\n            database = {\n                status: 'ERROR',\n                connectivity: { connected: false, latencyMs: 0, lastCheck: new Date().toISOString() },\n                file: { exists: false, path: '', sizeBytes: 0, sizeMB: 0, readable: false, writable: false },\n                tables: [],\n                warnings: [`Database health check failed: ${error.message}`],\n            };\n        }\n        const dbHealthy = database.status === 'HEALTHY' || database.status === 'DEGRADED';\n\n        // Overall status: combine services and database health\n        let overall: 'HEALTHY' | 'DEGRADED' | 'UNHEALTHY' | 'ERROR';\n        if (!dbHealthy) {\n            overall = database.status === 'ERROR' ? 'ERROR' : 'UNHEALTHY';\n        } else if (!servicesHealthy) {\n            overall = 'DEGRADED';\n        } else if (database.status === 'DEGRADED') {\n            overall = 'DEGRADED';\n        } else {\n            overall = 'HEALTHY';\n        }\n\n        return NextResponse.json({\n            status: overall,\n            timestamp: new Date().toISOString(),\n            services,\n            database,\n        });\n    } catch (error: any) {\n        console.error('[API /health] Error:', error);\n        return NextResponse.json({\n            status: 'ERROR',\n            timestamp: new Date().toISOString(),\n            error: error.message,\n        }, { status: 500 });\n    }\n}","replace_all":false},"tool_use_id":"toolu_01HPmXG5fygNSft6wWSBf8Ks"}

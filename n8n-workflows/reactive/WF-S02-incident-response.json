        "jsCode": "const alert = $('If: Can Auto-Fix').first().json;\nconst currentRetry = (alert.retryCount || 0) + 1;\n\nreturn {\n  json: {\n    ...alert,\n    retryCount: currentRetry,\n    canRetry: currentRetry < alert.maxRetries,\n    status: 'fix_failed'\n  }\n};"

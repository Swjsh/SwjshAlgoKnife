      "name": "HTTP: Fetch System Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 400],
      "parameters": {
        "method": "GET",
        "url": "http://localhost:3000/api/control",
        "options": {
          "timeout": 15000,
          "response": {

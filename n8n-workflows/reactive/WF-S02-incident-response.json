    {
      "id": "detect-issues",
      "name": "Code: Detect Issues from Health Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 400],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const healthData = $input.first().json;\nconst alerts = [];\nconst now = Date.now();\n\n// Check agents\nconst agents = healthData.agents || [];\nagents.forEach(agent => {\n  const lastHeartbeat = agent.lastHeartbeat ? new Date(agent.lastHeartbeat).getTime() : 0;\n  const minutesSince = (now - lastHeartbeat) / 60000;\n  \n  if (agent.status === 'error' || agent.status === 'crashed') {\n    alerts.push({\n      type: 'agent_crashed',\n      component: agent.id,\n      componentName: agent.name,\n      severity: 'P1',\n      message: `Agent ${agent.name} has crashed`,\n      context: { status: agent.status, lastHeartbeat: agent.lastHeartbeat }\n    });\n  } else if (minutesSince > 15) {\n    alerts.push({\n      type: 'agent_unresponsive',\n      component: agent.id,\n      componentName: agent.name,\n      severity: 'P2',\n      message: `Agent ${agent.name} unresponsive for ${minutesSince.toFixed(0)} minutes`,\n      context: { lastHeartbeat: agent.lastHeartbeat, minutesSince }\n    });\n  } else if (minutesSince > 5) {\n    alerts.push({\n      type: 'agent_stale',\n      component: agent.id,\n      componentName: agent.name,\n      severity: 'P3',\n      message: `Agent ${agent.name} heartbeat delayed (${minutesSince.toFixed(0)} min)`,\n      context: { lastHeartbeat: agent.lastHeartbeat, minutesSince }\n    });\n  }\n});\n\n// Check system metrics\nif (healthData.system) {\n  if (healthData.system.memoryUsage > 90) {\n    alerts.push({\n      type: 'high_memory',\n      component: 'system',\n      componentName: 'System',\n      severity: 'P2',\n      message: `High memory usage: ${healthData.system.memoryUsage}%`,\n      context: { memoryUsage: healthData.system.memoryUsage }\n    });\n  }\n  \n  if (healthData.system.cpuUsage > 85) {\n    alerts.push({\n      type: 'high_cpu',\n      component: 'system',\n      componentName: 'System',\n      severity: 'P3',\n      message: `High CPU usage: ${healthData.system.cpuUsage}%`,\n      context: { cpuUsage: healthData.system.cpuUsage }\n    });\n  }\n}\n\n// Check database\nif (healthData.database && !healthData.database.connected) {\n  alerts.push({\n    type: 'database_down',\n    component: 'database',\n    componentName: 'Database',\n    severity: 'P1',\n    message: 'Database connection lost',\n    context: { lastError: healthData.database.lastError }\n  });\n}\n\n// Check broker connections\nif (healthData.brokers) {\n  healthData.brokers.forEach(broker => {\n    if (!broker.connected) {\n      alerts.push({\n        type: 'broker_disconnected',\n        component: broker.id,\n        componentName: broker.name,\n        severity: 'P1',\n        message: `Broker ${broker.name} disconnected`,\n        context: { lastError: broker.lastError }\n      });\n    }\n  });\n}\n\n// Add metadata to each alert\nalerts.forEach(alert => {\n  alert.detectedAt = new Date().toISOString();\n  alert.source = 'proactive_health_check';\n  alert.retryCount = 0;\n});\n\nreturn alerts.length > 0 \n  ? alerts.map(a => ({ json: a }))\n  : [{ json: { noAlerts: true } }];"
      }
    },
    {
      "id": "normalize-webhook-alert",
      "name": "Code: Normalize Webhook Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 200],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $json;\n\n// Normalize incoming webhook alert to standard format\nconst alert = {\n  type: input.type || input.alertType || 'unknown',\n  component: input.component || input.agentId || input.service || 'unknown',\n  componentName: input.componentName || input.name || input.component || 'Unknown',\n  severity: normalizeSeverity(input.severity || input.priority || 'P3'),\n  message: input.message || input.description || 'Alert received',\n  context: input.context || input.data || {},\n  detectedAt: input.timestamp || new Date().toISOString(),\n  source: 'webhook',\n  retryCount: 0\n};\n\nfunction normalizeSeverity(s) {\n  const upper = String(s).toUpperCase();\n  if (upper === 'CRITICAL' || upper === 'P1' || upper === '1') return 'P1';\n  if (upper === 'HIGH' || upper === 'P2' || upper === '2') return 'P2';\n  if (upper === 'MEDIUM' || upper === 'P3' || upper === '3') return 'P3';\n  if (upper === 'LOW' || upper === 'P4' || upper === '4') return 'P4';\n  return 'P3'; // Default\n}\n\nreturn { json: alert };"
      }
    },

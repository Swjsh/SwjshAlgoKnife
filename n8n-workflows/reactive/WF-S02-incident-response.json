    {
      "id": "classify-p1",
      "name": "Code: Classify P1 Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 100],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const alert = $json;\n\n// Determine auto-fix capability and strategy for P1 incidents\nconst autoFixMap = {\n  'agent_crashed': { canFix: true, strategy: 'restart_agent', command: 'restart' },\n  'agent_unresponsive': { canFix: true, strategy: 'restart_agent', command: 'restart' },\n  'database_down': { canFix: false, strategy: 'escalate_immediate', command: null },\n  'broker_disconnected': { canFix: true, strategy: 'reconnect_broker', command: 'reconnect' },\n  'service_down': { canFix: true, strategy: 'restart_service', command: 'docker_restart' }\n};\n\nconst fixInfo = autoFixMap[alert.type] || { canFix: false, strategy: 'escalate_immediate', command: null };\n\nreturn {\n  json: {\n    ...alert,\n    canAutoFix: fixInfo.canFix,\n    fixStrategy: fixInfo.strategy,\n    fixCommand: fixInfo.command,\n    maxRetries: 3,\n    retryDelaySeconds: 30,\n    escalationTarget: 'chief',\n    requiresPostMortem: true\n  }\n};"
      }
    },
    {
      "id": "classify-p2",
      "name": "Code: Classify P2 Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 260],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const alert = $json;\n\n// Determine auto-fix for P2 incidents\nconst autoFixMap = {\n  'agent_unresponsive': { canFix: true, strategy: 'restart_agent', command: 'restart' },\n  'high_memory': { canFix: true, strategy: 'clear_cache', command: 'cache_clear' },\n  'api_timeout': { canFix: true, strategy: 'retry_connection', command: 'reconnect' },\n  'queue_backup': { canFix: true, strategy: 'flush_queue', command: 'queue_flush' }\n};\n\nconst fixInfo = autoFixMap[alert.type] || { canFix: false, strategy: 'log_and_alert', command: null };\n\nreturn {\n  json: {\n    ...alert,\n    canAutoFix: fixInfo.canFix,\n    fixStrategy: fixInfo.strategy,\n    fixCommand: fixInfo.command,\n    maxRetries: 2,\n    retryDelaySeconds: 45,\n    escalationTarget: 'system_channel',\n    requiresPostMortem: true\n  }\n};"
      }
    },
    {
      "id": "classify-p3",
      "name": "Code: Classify P3 Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 420],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const alert = $json;\n\n// P3 - Medium priority, mostly logging\nconst autoFixMap = {\n  'agent_stale': { canFix: true, strategy: 'restart_agent', command: 'restart' },\n  'high_cpu': { canFix: false, strategy: 'log_and_monitor', command: null },\n  'slow_response': { canFix: false, strategy: 'log_and_monitor', command: null },\n  'disk_warning': { canFix: false, strategy: 'log_and_alert', command: null }\n};\n\nconst fixInfo = autoFixMap[alert.type] || { canFix: false, strategy: 'log_only', command: null };\n\nreturn {\n  json: {\n    ...alert,\n    canAutoFix: fixInfo.canFix,\n    fixStrategy: fixInfo.strategy,\n    fixCommand: fixInfo.command,\n    maxRetries: 1,\n    retryDelaySeconds: 60,\n    escalationTarget: 'logs_channel',\n    requiresPostMortem: false\n  }\n};"

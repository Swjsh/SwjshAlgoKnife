      "id": "aggregate-results",
      "name": "Code: Aggregate Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [4320, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst results = items.map(i => i.json);\n\nconst resolved = results.filter(r => r.status === 'resolved');\nconst escalated = results.filter(r => r.status === 'escalated' || r.requires_human);\nconst logged = results.filter(r => r.status === 'logged');\n\nconst summary = {\n  timestamp: new Date().toISOString(),\n  total: results.length,\n  resolved: resolved.length,\n  escalated: escalated.length,\n  logged: logged.length,\n  details: results,\n  hasEscalations: escalated.length > 0,\n  hasP1: results.some(r => r.severity === 'P1'),\n  hasP2: results.some(r => r.severity === 'P2')\n};\n\nreturn { json: summary };"
      }

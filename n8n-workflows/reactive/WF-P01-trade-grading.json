    {
      "id": "parse-grade-response",
      "name": "Code: Parse and Validate Grade",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 300],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const response = $json;\nconst trade = $('Code: Build Analysis Prompt').first().json.trade;\n\nlet grading;\n\ntry {\n  // Try to parse the response - it might be nested in various ways\n  if (typeof response.content === 'string') {\n    // Extract JSON from response if wrapped in markdown\n    const jsonMatch = response.content.match(/\\{[\\s\\S]*\\}/);\n    grading = jsonMatch ? JSON.parse(jsonMatch[0]) : JSON.parse(response.content);\n  } else if (response.analysis) {\n    grading = typeof response.analysis === 'string' ? JSON.parse(response.analysis) : response.analysis;\n  } else if (response.grade) {\n    grading = response;\n  } else {\n    throw new Error('Could not find grade data in response');\n  }\n} catch (e) {\n  // Default grading if parsing fails\n  grading = {\n    grade: 'C',\n    score: 60,\n    entry_quality: { score: 60, notes: 'Unable to fully analyze - using default grade' },\n    exit_quality: { score: 60, notes: 'Unable to fully analyze - using default grade' },\n    risk_management: { score: 60, notes: 'Unable to fully analyze - using default grade' },\n    strategy_adherence: { score: 60, notes: 'Unable to fully analyze - using default grade' },\n    strengths: ['Trade completed'],\n    weaknesses: ['Analysis incomplete due to parsing error'],\n    lessons: ['Ensure trade data is complete for future analysis'],\n    pattern_detected: 'none',\n    recommendation: 'Review this trade manually',\n    _parseError: e.message\n  };\n}\n\n// Validate grade format\nconst validGrades = ['A', 'A-', 'B+', 'B', 'B-', 'C+', 'C', 'C-', 'D', 'F'];\nif (!validGrades.includes(grading.grade)) {\n  grading.grade = 'C';\n  grading._gradeNormalized = true;\n}\n\n// Ensure score is in range\ngrading.score = Math.max(0, Math.min(100, grading.score || 60));\n\n// Add trade metadata\ngrading.tradeId = trade.tradeId;\ngrading.symbol = trade.symbol;\ngrading.pnl = trade.pnl;\ngrading.strategy = trade.strategy;\ngrading.direction = trade.direction;\ngrading.timestamp = new Date().toISOString();\n\nreturn { json: grading };"
      }
    },
    {

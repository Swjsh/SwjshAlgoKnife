      }
    },
    {
      "id": "discord-hourly-summary",
      "name": "Discord: Hourly Health Summary",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [1920, 440],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "channelId": "={{ $env.DISCORD_SYSTEM_CHANNEL }}",
        "messageType": "embed",
        "embeds": {
          "values": [
            {
              "title": "Hourly System Health Report",
              "description": "={{ `Health Score: **${$json.compositeScore}%** | Status: **${$json.overallStatus.toUpperCase()}**` }}",
              "color": "={{ $json.compositeScore >= 80 ? 3066993 : ($json.compositeScore >= 50 ? 16776960 : 15158332) }}",
              "fields": {
                "values": [
                  {
                    "name": "SwjshAK API",
                    "value": "={{ $json.components.find(c => c.name === 'SwjshAK API')?.status || 'unknown' }}",
                    "inline": true

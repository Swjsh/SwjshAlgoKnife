    {
      "id": "calculate-health-score",
      "name": "Code: Calculate Composite Health Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 400],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Collect all health check responses\nconst swjshak = $('HTTP: SwjshAK API Health').first()?.json || {};\nconst openclaw = $('HTTP: OpenClaw Gateway Health').first()?.json || {};\nconst n8n = $('HTTP: n8n Instance Health').first()?.json || {};\nconst db = $('HTTP: Database Health Check').first()?.json || {};\nconst agents = $('HTTP: All Agents Status').first()?.json || {};\nconst alpaca = $('HTTP: Alpaca Broker Status').first()?.json || {};\nconst history = $('HTTP: Recent Health Metrics').first()?.json || {};\n\nconst now = new Date();\nconst components = [];\nlet totalWeight = 0;\nlet weightedScore = 0;\n\n// Helper: Check if response indicates healthy\nfunction isHealthy(response, healthKey = 'status') {\n  if (!response || response.statusCode >= 400) return false;\n  if (response[healthKey] === 'healthy' || response[healthKey] === 'ok') return true;\n  if (response.is_open !== undefined) return true; // Alpaca market clock\n  if (response.connected === true) return true;\n  if (typeof response === 'object' && Object.keys(response).length > 0) return true;\n  return false;\n}\n\n// SwjshAK API (weight: 25)\nconst swjshakHealthy = isHealthy(swjshak) && !swjshak.killswitch;\ncomponents.push({\n  name: 'SwjshAK API',\n  status: swjshakHealthy ? 'healthy' : 'unhealthy',\n  score: swjshakHealthy ? 100 : 0,\n  weight: 25,\n  details: { killswitch: swjshak.killswitch || false },\n  latency: swjshak.responseTime || null\n});\ntotalWeight += 25;\nweightedScore += swjshakHealthy ? 25 * 100 : 0;\n\n// OpenClaw Gateway (weight: 15)\nconst openclawHealthy = isHealthy(openclaw);\ncomponents.push({\n  name: 'OpenClaw Gateway',\n  status: openclawHealthy ? 'healthy' : 'unhealthy',\n  score: openclawHealthy ? 100 : 0,\n  weight: 15,\n  details: openclaw,\n  latency: openclaw.responseTime || null\n});\ntotalWeight += 15;\nweightedScore += openclawHealthy ? 15 * 100 : 0;\n\n// n8n Instance (weight: 10)\nconst n8nHealthy = isHealthy(n8n);\ncomponents.push({\n  name: 'n8n Instance',\n  status: n8nHealthy ? 'healthy' : 'unhealthy',\n  score: n8nHealthy ? 100 : 0,\n  weight: 10,\n  details: n8n\n});\ntotalWeight += 10;\nweightedScore += n8nHealthy ? 10 * 100 : 0;\n\n// Database (weight: 20)\nconst dbHealthy = isHealthy(db, 'connected');\ncomponents.push({\n  name: 'Database',\n  status: dbHealthy ? 'healthy' : 'unhealthy',\n  score: dbHealthy ? 100 : 0,\n  weight: 20,\n  details: db\n});\ntotalWeight += 20;\nweightedScore += dbHealthy ? 20 * 100 : 0;\n\n// Trading Agents (weight: 20)\nconst agentsList = agents.agents || agents || [];\nconst totalAgents = Array.isArray(agentsList) ? agentsList.length : 0;\nconst runningAgents = Array.isArray(agentsList) \n  ? agentsList.filter(a => a.status === 'running' || a.status === 'active').length \n  : 0;\nconst errorAgents = Array.isArray(agentsList)\n  ? agentsList.filter(a => a.status === 'error' || a.status === 'crashed').length\n  : 0;\nconst agentScore = totalAgents > 0 ? (runningAgents / totalAgents) * 100 : 0;\nconst agentHealthy = totalAgents > 0 && errorAgents === 0;\ncomponents.push({\n  name: 'Trading Agents',\n  status: errorAgents > 0 ? 'degraded' : (agentHealthy ? 'healthy' : 'unhealthy'),\n  score: agentScore,\n  weight: 20,\n  details: {\n    total: totalAgents,\n    running: runningAgents,\n    errors: errorAgents,\n    agents: Array.isArray(agentsList) ? agentsList.map(a => ({ name: a.name, status: a.status })) : []\n  }\n});\ntotalWeight += 20;\nweightedScore += 20 * agentScore;\n\n// Alpaca Broker (weight: 10)\nconst alpacaHealthy = isHealthy(alpaca);\ncomponents.push({\n  name: 'Alpaca Broker',\n  status: alpacaHealthy ? 'healthy' : 'unhealthy',\n  score: alpacaHealthy ? 100 : 0,\n  weight: 10,\n  details: {\n    is_open: alpaca.is_open,\n    next_open: alpaca.next_open,\n    next_close: alpaca.next_close\n  }\n});\ntotalWeight += 10;\nweightedScore += alpacaHealthy ? 10 * 100 : 0;\n\n// Calculate composite score\nconst compositeScore = totalWeight > 0 ? Math.round(weightedScore / totalWeight) : 0;\n\n// Determine overall status\nlet overallStatus = 'healthy';\nlet severity = 'info';\nif (compositeScore < 50) {\n  overallStatus = 'critical';\n  severity = 'P1';\n} else if (compositeScore < 80) {\n  overallStatus = 'degraded';\n  severity = 'P2';\n}\n\n// Calculate trend from history\nconst historyMetrics = history.metrics || [];\nlet trend = 'stable';\nlet trendValue = 0;\nif (historyMetrics.length >= 3) {\n  const recentAvg = historyMetrics.slice(0, 3).reduce((s, m) => s + (m.score || 0), 0) / 3;\n  const olderAvg = historyMetrics.slice(-3).reduce((s, m) => s + (m.score || 0), 0) / 3;\n  trendValue = recentAvg - olderAvg;\n  if (trendValue > 5) trend = 'improving';\n  else if (trendValue < -5) trend = 'degrading';\n}\n\n// Check for degradation alerts\nconst isDegrading = trend === 'degrading' && trendValue < -10;\n\nreturn {\n  json: {\n    timestamp: now.toISOString(),\n    compositeScore,\n    overallStatus,\n    severity,\n    components,\n    trend: {\n      direction: trend,\n      value: trendValue,\n      isDegrading\n    },\n    alerts: {\n      needsDiscordAlert: compositeScore < 50,\n      needsPulseTicket: compositeScore < 80,\n      needsAutoRecovery: compositeScore < 50 && errorAgents > 0,\n      isHourlySummary: new Date().getMinutes() < 5\n    },\n    agentDetails: {\n      total: totalAgents,\n      running: runningAgents,\n      errors: errorAgents\n    }\n  }\n};"
      },
      "notes": "Calculates weighted composite health score (0-100) from all components"
    },
    {
      "id": "store-metrics",

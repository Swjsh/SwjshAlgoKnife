              }
            },
            {
              "outputKey": "degraded",
              "conditions": {
                "options": {
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.compositeScore }}",
                    "rightValue": 80,
                    "operator": {
                      "type": "number",
                      "operation": "lt"
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "hourly_summary",
              "conditions": {
                "options": {
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.alerts.isHourlySummary }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "healthy",
              "conditions": {
                "options": {
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.compositeScore }}",
                    "rightValue": 80,
                    "operator": {
                      "type": "number",
                      "operation": "gte"
                    }
                  }
                ]
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
    {
      "id": "discord-critical-alert",
      "name": "Discord: Critical Alert",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [1920, 100],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "channelId": "={{ $env.DISCORD_CHIEF_CHANNEL }}",
        "content": "@here CRITICAL SYSTEM HEALTH ALERT",
        "messageType": "embed",
        "embeds": {
          "values": [
            {
              "title": "CRITICAL: System Health Below 50%",
              "description": "={{ `Composite Health Score: **${$json.compositeScore}%**\\n\\nImmediate attention required.` }}",
              "color": "15158332",
              "fields": {
                "values": [
                  {
                    "name": "Status",
                    "value": "={{ $json.overallStatus.toUpperCase() }}",
                    "inline": true
                  },
                  {
                    "name": "Trend",
                    "value": "={{ $json.trend.direction }}",
                    "inline": true
                  },
                  {
                    "name": "Agents",
                    "value": "={{ `${$json.agentDetails.running}/${$json.agentDetails.total} (${$json.agentDetails.errors} errors)` }}",
                    "inline": true
                  },
                  {
                    "name": "Failing Components",
                    "value": "={{ $json.components.filter(c => c.status !== 'healthy').map(c => `- ${c.name}: ${c.status}`).join('\\n') || 'None' }}",
                    "inline": false
                  }
                ]
              },
              "footer": "WF-OPS-01 Health Aggregator",
              "timestamp": "={{ $json.timestamp }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "discordBotApi": {
          "id": "discord-bot-cred",
          "name": "Discord Bot"
        }
      }
    },
    {
      "id": "check-auto-recovery",
      "name": "If: Auto-Recovery Possible",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2160, 100],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.alerts.needsAutoRecovery }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "identify-recovery-targets",
      "name": "Code: Identify Recovery Targets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2400, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const data = $input.first().json;\nconst components = data.components || [];\nconst recoveryActions = [];\n\n// Find agents that need restart\nconst agentComponent = components.find(c => c.name === 'Trading Agents');\nif (agentComponent && agentComponent.details?.agents) {\n  agentComponent.details.agents\n    .filter(a => a.status === 'error' || a.status === 'crashed')\n    .forEach(agent => {\n      recoveryActions.push({\n        type: 'restart_agent',\n        target: agent.name,\n        command: { command: 'restart', agentId: agent.name }\n      });\n    });\n}\n\n// Check if OpenClaw needs restart\nconst openclawComponent = components.find(c => c.name === 'OpenClaw Gateway');\nif (openclawComponent && openclawComponent.status === 'unhealthy') {\n  recoveryActions.push({\n    type: 'restart_service',\n    target: 'openclaw',\n    command: { command: 'docker_restart', service: 'openclaw' }\n  });\n}\n\nreturn recoveryActions.map(action => ({ json: action }));"
      },
      "notes": "Identifies which components can be auto-recovered"
    },
    {
      "id": "execute-recovery",
      "name": "HTTP: Execute Recovery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2640, 0],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/control",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.command) }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "notes": "Executes auto-recovery commands for failed components"
    },

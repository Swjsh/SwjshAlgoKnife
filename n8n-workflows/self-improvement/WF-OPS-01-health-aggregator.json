{
  "name": "WF-OPS-01: System Health Aggregator",
  "nodes": [
    {
      "id": "schedule-market-hours",
      "name": "Schedule: Every 5 Min Market Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 400],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 9-16 * * 1-5"
            }
          ]
        }
      },
      "notes": "Runs every 5 minutes from 9 AM to 4 PM ET on weekdays. Adjust cron for 9:30 start if needed."
    },
    {
      "id": "check-market-window",
      "name": "Code: Check Market Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 400],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Check if we're in actual market hours (9:30 AM - 4:00 PM ET)\nconst now = new Date();\nconst etHour = now.getUTCHours() - 5; // Simple EST offset\nconst etMinute = now.getUTCMinutes();\n\nconst marketOpen = (etHour === 9 && etMinute >= 30) || etHour >= 10;\nconst marketClose = etHour < 16;\nconst isWeekday = now.getUTCDay() >= 1 && now.getUTCDay() <= 5;\n\nconst inMarketHours = marketOpen && marketClose && isWeekday;\n\nreturn {\n  json: {\n    inMarketHours,\n    currentTime: now.toISOString(),\n    etHour,\n    etMinute,\n    checkType: inMarketHours ? 'full' : 'minimal'\n  }\n};"
      },
      "notes": "Validates we're in actual market hours (9:30-16:00 ET)"
    },
    {
      "id": "if-market-hours",
      "name": "If: In Market Hours",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 400],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.inMarketHours }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },

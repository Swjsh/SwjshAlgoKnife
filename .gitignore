# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit real secrets
.env
.env.local
.env.*.local
.env.development
.env.production
.env.integration

# Keep only the example template
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large media files (deployment blockers)
*.mp4
*.mov
*.avi
*.mkv
*.pdf
*.docx
docs/boba_strategy/
docs/WeBull History/

# Python cache
__pycache__/
*.pyc

# Windows reserved
nul

# Database
journal.db

# Logs
dev.log
server.log
/logs/

# Backtest & paper-sim artifacts
/data/_backtests/
/data/_paper/
/data/pivot_pete_backtest_*.json
/data/pivot_pete_paper_latest.json

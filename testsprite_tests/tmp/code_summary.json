{
  "tech_stack": [
    "TypeScript 5",
    "Next.js 16.1.1",
    "React 19.2.3",
    "SQLite (better-sqlite3 12.5.0)",
    "Zod 4.3.4",
    "Tailwind CSS 4.1.18",
    "Firebase 12.7.0",
    "Vitest 4.0.16",
    "Node.js",
    "lightweight-charts 5.1.0"
  ],
  "features": [
    {
      "name": "Signals API",
      "description": "Retrieves the latest trading signals from the database",
      "files": ["src/app/api/signals/route.ts", "src/lib/db.ts"],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Signals API",
          "version": "1.0.0"
        },
        "paths": {
          "/api/signals": {
            "get": {
              "summary": "Get latest signals",
              "description": "Retrieves the 10 most recent trading signals ordered by timestamp",
              "responses": {
                "200": {
                  "description": "Successful response"
                },
                "500": {
                  "description": "Server error"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "Journal/Trades API",
      "description": "CRUD operations for trade journal entries with Zod validation",
      "files": ["src/app/api/journal/route.ts", "src/lib/db.ts"],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Journal API",
          "version": "1.0.0"
        },
        "paths": {
          "/api/journal": {
            "get": {
              "summary": "Get all trades",
              "description": "Retrieves all trades from the journal ordered by entry date (descending)",
              "responses": {
                "200": {"description": "Successful response"},
                "500": {"description": "Server error"}
              }
            },
            "post": {
              "summary": "Create a new trade",
              "description": "Creates a new trade entry with validation",
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "required": ["symbol", "direction", "entry_price", "size"],
                      "properties": {
                        "symbol": {"type": "string"},
                        "direction": {"type": "string", "enum": ["LONG", "SHORT"]},
                        "entry_price": {"type": "number"},
                        "size": {"type": "number"}
                      }
                    }
                  }
                }
              },
              "responses": {
                "200": {"description": "Trade created"},
                "400": {"description": "Validation error"},
                "500": {"description": "Server error"}
              }
            }
          }
        }
      }
    },
    {
      "name": "TradingView Webhook API",
      "description": "Receives and processes TradingView alert webhooks with authentication and trade execution",
      "files": ["src/app/api/webhook/tradingview/route.ts", "src/lib/engine/executor.ts"],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "TradingView Webhook API",
          "version": "1.0.0"
        },
        "paths": {
          "/api/webhook/tradingview": {
            "post": {
              "summary": "Receive TradingView alerts",
              "description": "Webhook endpoint for TradingView alerts with secret authentication",
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "required": ["symbol", "action"],
                      "properties": {
                        "symbol": {"type": "string"},
                        "action": {"type": "string"},
                        "price": {"type": "number"},
                        "strategy": {"type": "string"}
                      }
                    }
                  }
                }
              },
              "responses": {
                "200": {"description": "Webhook processed"},
                "400": {"description": "Invalid request"},
                "401": {"description": "Unauthorized"},
                "500": {"description": "Server error"}
              }
            }
          }
        }
      }
    },
    {
      "name": "KillSwitch API",
      "description": "Emergency halt system for stopping trading agents globally or individually",
      "files": ["src/app/api/killswitch/route.ts", "src/lib/engine/risk/KillSwitch.ts"],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "KillSwitch API",
          "version": "1.0.0"
        },
        "paths": {
          "/api/killswitch": {
            "get": {
              "summary": "Get KillSwitch status",
              "responses": {
                "200": {"description": "Success"},
                "500": {"description": "Error"}
              }
            },
            "post": {
              "summary": "Trigger or reset KillSwitch",
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "required": ["action"],
                      "properties": {
                        "action": {"type": "string", "enum": ["trigger", "reset"]},
                        "agentId": {"type": "string"},
                        "reason": {"type": "string"}
                      }
                    }
                  }
                }
              },
              "responses": {
                "200": {"description": "Success"},
                "400": {"description": "Invalid action"},
                "500": {"description": "Error"}
              }
            }
          }
        }
      }
    },
    {
      "name": "Agents Management API",
      "description": "Manages autonomous trading agents with performance tracking",
      "files": ["src/app/api/agents/route.ts", "src/lib/db.ts"],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Agents API",
          "version": "1.0.0"
        },
        "paths": {
          "/api/agents": {
            "get": {
              "summary": "Get all agents",
              "responses": {
                "200": {"description": "Success"},
                "500": {"description": "Error"}
              }
            },
            "post": {
              "summary": "Create a new agent",
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "name": {"type": "string"},
                        "market": {"type": "string"},
                        "strategy": {"type": "string"}
                      }
                    }
                  }
                }
              },
              "responses": {
                "200": {"description": "Agent created"},
                "500": {"description": "Error"}
              }
            }
          }
        }
      }
    }
  ]
}
